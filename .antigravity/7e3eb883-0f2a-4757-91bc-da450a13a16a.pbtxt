      arguments_json: "{\"CommandLine\":\"node -e \\\"\\nconst fs = require(\'fs\');\\nconst buf = fs.readFileSync(\'public/assets/aistudio/Image_16_f1c299ca.markdown\');\\n// Convert buffer to bit string\\nlet bits = \'\';\\nfor (const b of buf) bits += b.toString(2).padStart(8, \'0\');\\n// Check where normal ASCII/UTF-8 starts and stops by scanning sliding windows of 8 bits at shifts 0..7\\nfunction decodeAt(bitOffset, lenBytes) {\\n  const arr = [];\\n  for (let i = 0; i < lenBytes && bitOffset + i*8 + 8 <= bits.length; i++) {\\n    arr.push(parseInt(bits.slice(bitOffset + i*8, bitOffset + i*8 + 8), 2));\\n  }\\n  return Buffer.from(arr).toString(\'utf8\');\\n}\\nfunction scoreStr(s) {\\n  let score = 0;\\n  for (const ch of s) {\\n    const c = ch.charCodeAt(0);\\n    if ((c >= 32 && c <= 126) || c === 10 || c === 9 || (c >= 0x0600 && c <= 0x06FF) || c === 0x200C || c === 0x00AB || c === 0x00BB || c === 0x2013 || c === 0x2014) score++;\\n    else score -= 3;\\n  }\\n  return score;\\n}\\nlet out = \'\';\\nlet pos = 0;\\nlet curShift = 0;\\nwhile (pos + 8 <= bits.length) {\\n  // Check if next 30 bytes at curShift look good\\n  const sCur = decodeAt(pos, 30);\\n  if (scoreStr(sCur) >= 20) {\\n    out += decodeAt(pos, 1);\\n    pos += 8;\\n  } else {\\n    // Try finding best bit offset within +1..+40 bits\\n    let bestOff = -1, bestScore = -999;\\n    for (let d = 1; d <= 64; d++) {\\n      const s = decodeAt(pos + d, 30);\\n      const sc = scoreStr(s);\\n      if (sc > bestScore) { bestScore = sc; bestOff = d; }\\n    }\\n    if (bestScore >= 20) {\\n      out += \'\\\\n[...resync +\' + bestOff + \'b...]\\\\n\';\\n      pos += bestOff;\\n    } else {\\n      out += decodeAt(pos, 1);\\n      pos += 8;\\n    }\\n  }\\n}\\nconsole.log(out);\\n\\\"\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":5000, \"toolAction\":\"Decoding full design specification\", \"toolSummary\":\"Decode design specification\"}"
