  code_action {
    action_spec {
      create_file {
        instruction: "import { ArrowLeft, Check, ChevronLeft, ShieldCheck } from \'lucide-react\';\nimport {\n  IMAGES,\n  PRODUCTS,\n  PROJECTS,\n  formatToman,\n  type ArchitecturalProduct,\n  type CategoryId,\n} from \'../data/catalog\';\nimport { ResilientImage } from \'./ResilientImage\';\nimport type { ScreenId } from \'./Header\';\n\ninterface HomeScreenProps {\n  onNavigate: (screen: ScreenId) => void;\n  onSelectCategory: (category: CategoryId) => void;\n  onInspectProduct: (product: ArchitecturalProduct) => void;\n}\n\nconst ENGINEERING_METRICS = [\n  { value: \'\333\261\333\270+ \330\263\330\247\331\204\', label: \'\330\252\330\254\330\261\330\250\331\207 \330\252\330\256\330\265\330\265\333\214 \331\205\331\207\331\206\330\257\330\263\333\214 \331\210 \330\247\330\254\330\261\330\247\333\214 \330\263\333\214\330\263\330\252\331\205\342\200\214\331\207\330\247\333\214 \331\210\330\261\331\210\330\257\333\214\' },\n  { value: \'\333\261,\333\264\333\262\333\260+\', label: \'\331\276\330\261\331\210\332\230\331\207 \330\264\330\247\330\256\330\265 \330\252\330\254\330\247\330\261\333\214\330\214 \330\247\330\257\330\247\330\261\333\214 \331\210 \331\210\333\214\331\204\330\247\333\214\333\214 \330\247\330\254\330\261\330\247\330\264\330\257\331\207\' },\n  { value: \'EN 16005\', label: \'\330\247\331\206\330\267\330\250\330\247\331\202 \332\251\330\247\331\205\331\204 \330\250\330\247 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \330\247\333\214\331\205\331\206\333\214 \330\247\330\261\331\210\331\276\330\247 \331\210 \330\242\331\204\331\205\330\247\331\206\' },\n  { value: \'\333\265 \330\252\330\247 \333\261\333\260 \330\263\330\247\331\204\', label: \'\332\257\330\247\330\261\330\247\331\206\330\252\333\214 \330\261\330\263\331\205\333\214 \331\205\331\210\330\252\331\210\330\261\330\214 \331\276\330\261\331\210\331\201\333\214\331\204 \331\210 \330\256\330\257\331\205\330\247\330\252 \331\276\330\263 \330\247\330\262 \331\201\330\261\331\210\330\264\' },\n];\n\nconst WORKFLOW_STEPS = [\n  {\n    index: \'\333\260\333\261.\',\n    title: \'\330\250\330\247\330\262\330\257\333\214\330\257 \331\201\331\206\333\214 \331\210 \330\250\330\261\330\257\330\247\330\264\330\252 \331\204\333\214\330\262\330\261\333\214\',\n    description:\n      \'\330\247\331\206\330\257\330\247\330\262\331\207\342\200\214\332\257\333\214\330\261\333\214 \330\257\331\202\333\214\331\202 \330\257\331\207\330\247\331\206\331\207\330\214 \330\250\330\261\330\261\330\263\333\214 \330\263\330\247\330\262\331\207 \332\251\331\201 \331\210 \330\263\331\202\331\201 \331\210 \330\252\330\255\331\204\333\214\331\204 \331\205\333\214\330\262\330\247\331\206 \330\252\330\261\330\257\330\257 \330\261\331\210\330\262\330\247\331\206\331\207 \330\252\331\210\330\263\330\267 \331\205\331\207\331\206\330\257\330\263 \331\206\330\247\330\270\330\261 \331\276\330\261\331\210\332\230\331\207.\',\n  },\n  {\n    index: \'\333\260\333\262.\',\n    title: \'\330\267\330\261\330\247\330\255\333\214 \331\205\331\207\331\206\330\257\330\263\333\214 \331\210 \331\205\330\255\330\247\330\263\330\250\330\247\330\252 \330\250\330\247\330\261\',\n    description:\n      \'\330\247\330\261\330\247\330\246\331\207 \331\206\331\202\330\264\331\207\342\200\214\331\207\330\247\333\214 \330\247\330\254\330\261\330\247\333\214\333\214 \330\264\330\247\331\276\342\200\214\330\257\330\261\330\247\331\210\333\214\331\206\332\257\330\214 \331\205\330\255\330\247\330\263\330\250\330\247\330\252 \330\250\330\247\330\261 \330\250\330\247\330\257 \331\210 \330\250\330\261\331\201 \331\210 \330\247\331\206\330\252\330\256\330\247\330\250 \330\266\330\256\330\247\331\205\330\252 \330\264\333\214\330\264\331\207 \331\204\331\205\333\214\331\206\330\252 \333\214\330\247 \330\263\332\251\331\210\330\261\333\214\330\252.\',\n  },\n  {\n    index: \'\333\260\333\263.\',\n    title: \'\330\252\331\210\331\204\333\214\330\257 \330\257\331\202\333\214\331\202 \331\210 \332\251\331\206\330\252\330\261\331\204 \332\251\333\214\331\201\333\214\330\252\',\n    description:\n      \'\331\205\331\210\331\206\330\252\330\247\332\230 \330\247\331\276\330\261\330\247\330\252\331\210\330\261\330\214 \331\205\330\247\330\264\333\214\331\206\342\200\214\332\251\330\247\330\261\333\214 CNC \331\276\330\261\331\210\331\201\333\214\331\204\342\200\214\331\207\330\247\333\214 \330\242\331\204\331\210\331\205\333\214\331\206\333\214\331\210\331\205 \333\266\333\260\333\266\333\263 \331\210 \330\252\330\263\330\252 \330\247\333\214\331\205\331\206\333\214 \330\264\333\214\330\264\331\207 \331\276\333\214\330\264 \330\247\330\262 \330\247\330\261\330\263\330\247\331\204 \330\250\331\207 \332\251\330\247\330\261\332\257\330\247\331\207.\',\n  },\n  {\n    index: \'\333\260\333\264.\',\n    title: \'\331\206\330\265\330\250 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \331\210 \332\257\330\247\330\261\330\247\331\206\330\252\333\214 \330\261\330\263\331\205\333\214\',\n    description:\n      \'\331\206\330\265\330\250 \330\263\330\261\333\214\330\271 \330\250\330\247 \330\252\330\261\330\247\330\262 \331\204\333\214\330\262\330\261\333\214\330\214 \330\252\331\206\330\270\333\214\331\205 \331\207\331\210\330\264\331\205\331\206\330\257 \330\263\331\206\330\263\331\210\330\261\331\207\330\247 \331\210 \330\252\330\255\331\210\333\214\331\204 \330\257\331\201\330\252\330\261\332\206\331\207 \332\257\330\247\330\261\330\247\331\206\330\252\333\214 \331\276\331\206\330\254 \330\252\330\247 \330\257\331\207 \330\263\330\247\331\204\331\207 \330\247\331\204\330\263\330\247.\',\n  },\n];\n\nexport function HomeScreen({\n  onNavigate,\n  onSelectCategory,\n  onInspectProduct,\n}: HomeScreenProps) {\n  const featuredProject = PROJECTS[0];\n\n  const handleOpenCategory = (cat: CategoryId) => {\n    onSelectCategory(cat);\n    onNavigate(\'catalog\');\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <div className=\"space-y-20 lg:space-y-28 pb-10\">\n      {/* Hero Section: 12-column RTL Split with items-stretch */}\n      <section className=\"max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 pt-6 lg:pt-10\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch\">\n          {/* Right Column (Text Proposition) */}\n          <div className=\"lg:col-span-6 flex flex-col justify-between py-2 lg:py-4 space-y-8\">\n            <div className=\"space-y-6\">\n              <p className=\"text-xs sm:text-sm font-semibold text-[#006C49] tracking-tight\">\n                \330\263\333\214\330\263\330\252\331\205\342\200\214\331\207\330\247\333\214 \331\207\331\210\330\264\331\205\331\206\330\257 \331\205\330\271\331\205\330\247\330\261\333\214 \330\247\331\204\330\263\330\247 \302\267 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \331\205\331\207\331\206\330\257\330\263\333\214 \330\242\331\204\331\205\330\247\331\206\n              </p>\n\n              <h1 className=\"text-[30px] sm:text-[38px] lg:text-[44px] font-extrabold text-[#0F172A] leading-[1.42] tracking-tight\">\n                \331\205\331\207\331\206\330\257\330\263\333\214 \330\264\331\201\330\247\331\201\333\214\330\252 \330\257\330\261{\' \'}\n                <span className=\"text-emerald-gradient\">\330\257\330\261\330\250 \330\247\330\252\331\210\331\205\330\247\330\252\333\214\332\251</span> \331\210{\' \'}\n                <span className=\"text-emerald-gradient\">\331\206\331\205\330\247\333\214 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214</span> \331\205\330\257\330\261\331\206\n              </h1>\n\n              <p className=\"text-[15px] sm:text-[17px] text-[#334155] leading-[1.85] max-w-xl\">\n                \330\267\330\261\330\247\330\255\333\214 \331\210 \330\247\330\254\330\261\330\247\333\214 \333\214\332\251\331\276\330\247\330\261\332\206\331\207 \331\210\330\261\331\210\330\257\333\214\342\200\214\331\207\330\247\333\214 \331\207\331\210\330\264\331\205\331\206\330\257\330\214 \331\206\330\261\330\257\331\207 \331\210 \331\207\331\206\330\257\330\261\333\214\331\204 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \330\257\331\201\331\206\333\214\330\214 \330\263\330\247\333\214\330\250\330\247\331\206\342\200\214\331\207\330\247\333\214\n                \331\205\330\271\331\204\331\202 \330\247\330\263\331\276\330\247\333\214\330\257\330\261 \331\210 \332\251\330\261\332\251\330\261\331\207\342\200\214\331\207\330\247\333\214 \330\264\331\201\330\247\331\201 \331\276\331\204\333\214\342\200\214\332\251\330\261\330\250\331\206\330\247\330\252 \330\250\330\261\330\247\333\214 \331\205\330\271\331\205\330\247\330\261\330\247\331\206\330\214 \330\263\330\247\330\262\331\206\330\257\332\257\330\247\331\206 \330\250\330\261\330\254\342\200\214\331\207\330\247\333\214 \331\204\331\210\332\251\330\263 \331\210\n                \331\276\330\261\331\210\332\230\331\207\342\200\214\331\207\330\247\333\214 \330\264\330\247\330\256\330\265.\n              </p>\n            </div>\n\n            <div className=\"space-y-6\">\n              <div className=\"flex flex-wrap items-center gap-3.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    onNavigate(\'estimator\');\n                    window.scrollTo({ top: 0, behavior: \'smooth\' });\n                  }}\n                  className=\"btn-primary-elessa rounded-full px-7 py-3.5 text-sm sm:text-[15px] font-bold inline-flex items-center gap-2.5 whitespace-nowrap cursor-pointer\"\n                >\n                  <span>\331\205\330\255\330\247\330\263\330\250\331\207 \331\202\333\214\331\205\330\252 \331\210 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261</span>\n                  <ArrowLeft className=\"w-4 h-4 shrink-0\" />\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenCategory(\'all\')}\n                  className=\"btn-secondary-elessa rounded-full px-6 py-3.5 text-sm sm:text-[15px] font-semibold inline-flex items-center gap-2 whitespace-nowrap cursor-pointer\"\n                >\n                  <span>\331\205\330\264\330\247\331\207\330\257\331\207 \332\251\330\247\330\252\330\247\331\204\331\210\332\257 \331\205\330\255\330\265\331\210\331\204\330\247\330\252</span>\n                  <ChevronLeft className=\"w-4 h-4 shrink-0\" />\n                </button>\n              </div>\n\n              <div className=\"flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-[13px] text-[#565E74]\">\n                <span className=\"inline-flex items-center gap-1.5\">\n                  <Check className=\"w-3.5 h-3.5 text-[#10B981]\" />\n                  \330\250\330\247\330\262\330\257\333\214\330\257 \331\210 \330\250\330\261\330\257\330\247\330\264\330\252 \331\204\333\214\330\262\330\261\333\214 \330\257\330\261 \330\252\331\207\330\261\330\247\331\206 \331\210 \332\251\330\261\330\254\n                </span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\n                  \302\267\n                </span>\n                <span className=\"inline-flex items-center gap-1.5\">\n                  <Check className=\"w-3.5 h-3.5 text-[#10B981]\" />\n                  \331\205\331\210\330\252\331\210\330\261\331\207\330\247\333\214 \330\250\330\261\330\247\330\264\331\204\330\263 \330\250\333\214\342\200\214\330\265\330\257\330\247 (Dunkermotoren)\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Left Column (Focal Architectural Visual Carrier) */}\n          <div className=\"lg:col-span-6 relative\">\n            <div className=\"relative h-full min-h-[320px] sm:min-h-[420px] lg:min-h-[470px] rounded-[32px] overflow-hidden border border-white shadow-[0_20px_50px_-12px_rgba(15,23,42,0.12)]\">\n              <ResilientImage\n                src={IMAGES.heroEntrance}\n                alt=\"\331\210\330\261\331\210\330\257\333\214 \330\257\330\261\330\250 \330\247\330\252\331\210\331\205\330\247\330\252\333\214\332\251 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \330\250\330\257\331\210\331\206 \331\201\330\261\333\214\331\205 \330\247\331\204\330\263\330\247 \330\257\330\261 \331\204\330\247\330\250\333\214 \331\205\330\257\330\261\331\206\"\n                className=\"w-full h-full object-cover\"\n              />\n              <div\n                aria-hidden=\"true\"\n                className=\"absolute inset-0 bg-gradient-to-t from-[#0F172A]/60 via-transparent to-transparent\"\n              />\n\n              {/* Frosted Glass Architectural Spec Overlay */}\n              <div className=\"absolute bottom-5 inset-x-5 sm:inset-x-6 glass-surface rounded-2xl p-4 sm:px-5 flex items-center justify-between gap-4\">\n                <div className=\"min-w-0\">\n                  <div className=\"text-xs text-[#565E74]\">\330\263\330\261\333\214 \331\276\330\261\332\206\331\205\330\257\330\247\330\261 \331\210\330\261\331\210\330\257\333\214 \331\207\331\210\330\264\331\205\331\206\330\257</div>\n                  <div className=\"text-sm sm:text-base font-bold text-[#0F172A] truncate\">\n                    \330\257\330\261\330\250 \330\247\330\263\331\204\330\247\333\214\330\257\333\214\331\206\332\257 \330\257\331\210 \331\204\330\252 <span className=\"font-tech text-[#006C49]\">EL-SL420</span>\n                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => onInspectProduct(PRODUCTS[0])}\n                  className=\"rounded-full bg-[#0F172A] text-white hover:bg-[#006C49] transition-colors px-4 py-2 text-xs font-semibold whitespace-nowrap shrink-0 cursor-pointer\"\n                >\n                  \330\254\330\262\330\246\333\214\330\247\330\252 \331\201\331\206\333\214\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Full-Width 4-Column Engineering Metrics Strip Directly Below Hero Split */}\n        <div className=\"mt-10 surface-card-1 rounded-[28px] p-6 sm:p-8 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8\">\n          {ENGINEERING_METRICS.map((metric, idx) => (\n            <div\n              key={metric.value}\n              className={`${\n                idx !== 0 ? \'lg:border-r lg:border-slate-200/80 lg:pr-8\' : \'\'\n              } space-y-1.5`}\n            >\n              <div className=\"text-2xl sm:text-3xl font-extrabold text-[#0F172A] tabular-nums tracking-tight\">\n                {metric.value}\n              </div>\n              <p className=\"text-xs sm:text-[13px] text-[#565E74] leading-6\">{metric.label}</p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* Asymmetric Architectural Divisions Bento Showcase */}\n      <section className=\"max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 space-y-8\">\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\">\n          <div className=\"space-y-2 max-w-2xl\">\n            <p className=\"text-xs font-semibold text-[#006C49]\">\332\257\330\261\331\210\331\207\342\200\214\331\207\330\247\333\214 \330\252\330\256\330\265\330\265\333\214 \331\205\330\255\330\265\331\210\331\204\330\247\330\252</p>\n            <h2 className=\"text-2xl sm:text-[32px] font-bold text-[#0F172A]\">\n              \332\206\331\207\330\247\330\261 \330\263\330\252\331\210\331\206 \331\205\331\207\331\206\330\257\330\263\333\214 \330\257\330\261 \330\263\333\214\330\263\330\252\331\205\342\200\214\331\207\330\247\333\214 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \331\210 \331\210\330\261\331\210\330\257\333\214\n            </h2>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => handleOpenCategory(\'all\')}\n            className=\"inline-flex items-center gap-1.5 text-sm font-semibold text-[#006C49] hover:text-[#059669] transition-colors whitespace-nowrap self-start sm:self-auto cursor-pointer\"\n          >\n            <span>\331\205\330\264\330\247\331\207\330\257\331\207 \330\252\331\205\330\247\331\205\333\214 \331\205\330\257\331\204\342\200\214\331\207\330\247</span>\n            <ChevronLeft className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8\">\n          {/* Card 1: Automatic Doors (Wide) */}\n          <article className=\"lg:col-span-7 surface-card-2 rounded-[28px] overflow-hidden flex flex-col\">\n            <div className=\"relative aspect-[16/10] overflow-hidden\">\n              <ResilientImage\n                src={IMAGES.telescopicDoor}\n                alt=\"\330\257\330\261\330\250 \330\247\330\252\331\210\331\205\330\247\330\252\333\214\332\251 \330\252\331\204\330\263\332\251\331\210\331\276\333\214 \331\210 \330\247\330\263\331\204\330\247\333\214\330\257\333\214\331\206\332\257 \330\247\331\204\330\263\330\247\"\n                className=\"w-full h-full object-cover\"\n              />\n              <span className=\"absolute top-4 right-4 glass-surface rounded-full px-3.5 py-1.5 text-xs font-semibold text-[#0F172A]\">\n                \330\257\330\261\330\250 \330\247\330\252\331\210\331\205\330\247\330\252\333\214\332\251\n              </span>\n            </div>\n            <div className=\"p-6 sm:p-7 flex-1 flex flex-col justify-between gap-5\">\n              <div className=\"space-y-2.5\">\n                <div className=\"flex items-center gap-2 text-xs text-[#565E74]\">\n                  <span className=\"font-tech\">EL-SL420 \302\267 EL-TL600</span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>\331\205\331\210\330\252\331\210\330\261 \330\250\330\261\330\247\330\264\331\204\330\263 \333\262\333\264 \331\210\331\204\330\252</span>\n                </div>\n                <h3 className=\"text-xl font-bold text-[#0F172A]\">\n                  \330\257\330\261\330\250\342\200\214\331\207\330\247\333\214 \330\247\330\252\331\210\331\205\330\247\330\252\333\214\332\251 \330\247\330\263\331\204\330\247\333\214\330\257\333\214\331\206\332\257 \331\210 \330\252\331\204\330\263\332\251\331\210\331\276\333\214\n                </h3>\n                <p className=\"text-sm text-[#334155] leading-7\">\n                  \331\205\331\206\330\247\330\263\330\250 \331\204\330\247\330\250\333\214 \330\250\330\261\330\254\342\200\214\331\207\330\247\330\214 \331\205\330\261\330\247\332\251\330\262 \330\252\330\254\330\247\330\261\333\214 \331\276\330\261\330\252\330\261\330\257\330\257 \331\210 \331\201\330\266\330\247\331\207\330\247\333\214 \330\257\330\261\331\205\330\247\331\206\333\214 \330\250\330\247 \331\201\330\261\333\214\331\205\342\200\214\331\207\330\247\333\214 \330\250\330\247\330\261\333\214\332\251 \333\263\333\262\n                  \331\205\333\214\331\204\333\214\342\200\214\331\205\330\252\330\261\333\214 \331\210 \330\250\330\247\330\262\330\264\331\210\333\214 \331\205\331\201\333\214\330\257 \330\252\330\247 \333\266\333\266 \330\257\330\261\330\265\330\257 \330\257\331\207\330\247\331\206\331\207.\n                </p>\n              </div>\n              <div className=\"flex items-center justify-between pt-3 border-t border-slate-100\">\n                <span className=\"text-xs text-[#565E74] tabular-nums\">\n                  \330\264\330\261\331\210\330\271 \330\247\330\262 <strong className=\"text-[#0F172A]\">{formatToman(148_000_000)}</strong>\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenCategory(\'automatic-doors\')}\n                  className=\"inline-flex items-center gap-1.5 text-sm font-semibold text-[#006C49] hover:text-[#059669] cursor-pointer\"\n                >\n                  <span>\330\250\330\261\330\261\330\263\333\214 \331\205\330\257\331\204\342\200\214\331\207\330\247</span>\n                  <ArrowLeft className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          </article>\n\n          {/* Card 2: Glass Railings */}\n          <article className=\"lg:col-span-5 surface-card-2 rounded-[28px] overflow-hidden flex flex-col\">\n            <div className=\"relative aspect-[16/10] overflow-hidden\">\n              <ResilientImage\n                src={IMAGES.glassRailing}\n                alt=\"\331\206\330\261\330\257\331\207 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \330\257\331\201\331\206\333\214 \331\210 \331\207\331\206\330\257\330\261\333\214\331\204 \330\247\332\251\330\263\331\276\331\210\330\262 \330\247\331\204\330\263\330\247\"\n                className=\"w-full h-full object-cover\"\n              />\n              <span className=\"absolute top-4 right-4 glass-surface rounded-full px-3.5 py-1.5 text-xs font-semibold text-[#0F172A]\">\n                \331\207\331\206\330\257\330\261\333\214\331\204 \330\247\332\251\330\263\331\276\331\210\330\262 \331\210 \330\257\331\201\331\206\333\214\n              </span>\n            </div>\n            <div className=\"p-6 sm:p-7 flex-1 flex flex-col justify-between gap-5\">\n              <div className=\"space-y-2.5\">\n                <div className=\"flex items-center gap-2 text-xs text-[#565E74]\">\n                  <span className=\"font-tech\">EL-UC180 \302\267 EL-EX120</span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>\330\264\333\214\330\264\331\207 \331\204\331\205\333\214\331\206\330\252 \333\261\333\266 \330\252\330\247 \333\262\333\261.\333\265 \331\205\333\214\331\204</span>\n                </div>\n                <h3 className=\"text-xl font-bold text-[#0F172A]\">\n                  \331\206\330\261\330\257\331\207 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \330\257\331\201\331\206\333\214 \331\210 \331\276\330\247\333\214\331\207 \330\247\330\263\331\276\333\214\332\257\330\247\330\252\n                </h3>\n                <p className=\"text-sm text-[#334155] leading-7\">\n                  \330\257\333\214\330\257 \330\250\330\257\331\210\331\206 \331\205\330\247\331\206\330\271 \330\257\330\261 \330\252\330\261\330\247\330\263\342\200\214\331\207\330\247\333\214 \331\205\330\261\330\252\331\201\330\271\330\214 \331\210\333\214\330\257\331\207\330\247\333\214 \331\205\330\261\332\251\330\262\333\214 \331\210 \331\276\331\204\331\207\342\200\214\331\207\330\247\333\214 \331\205\330\271\331\204\331\202 \330\250\330\247 \331\276\330\261\331\210\331\201\333\214\331\204\n                  \330\242\331\204\331\210\331\205\333\214\331\206\333\214\331\210\331\205 \333\266\333\260\333\266\333\263 \331\210 \331\201\331\210\331\204\330\247\330\257 \330\266\330\257\330\262\331\206\332\257 \333\263\333\261\333\266.\n                </p>\n              </div>\n              <div className=\"flex items-center justify-between pt-3 border-t border-slate-100\">\n                <span className=\"text-xs text-[#565E74] tabular-nums\">\n                  \330\264\330\261\331\210\330\271 \330\247\330\262 <strong className=\"text-[#0F172A]\">{formatToman(14_200_000)}</strong> / \331\205\330\252\330\261\330\267\331\210\331\204\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenCategory(\'glass-railings\')}\n                  className=\"inline-flex items-center gap-1.5 text-sm font-semibold text-[#006C49] hover:text-[#059669] cursor-pointer\"\n                >\n                  <span>\330\250\330\261\330\261\330\263\333\214 \331\205\330\257\331\204\342\200\214\331\207\330\247</span>\n                  <ArrowLeft className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          </article>\n\n          {/* Card 3: Smart Facades */}\n          <article className=\"lg:col-span-5 surface-card-2 rounded-[28px] overflow-hidden flex flex-col\">\n            <div className=\"relative aspect-[16/10] overflow-hidden\">\n              <ResilientImage\n                src={IMAGES.smartFacade}\n                alt=\"\330\263\330\247\333\214\330\250\330\247\331\206 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \331\205\330\271\331\204\331\202 \331\210 \331\206\331\205\330\247\333\214 \330\247\330\263\331\276\330\247\333\214\330\257\330\261 \330\247\331\204\330\263\330\247\"\n                className=\"w-full h-full object-cover\"\n              />\n              <span className=\"absolute top-4 right-4 glass-surface rounded-full px-3.5 py-1.5 text-xs font-semibold text-[#0F172A]\">\n                \331\206\331\205\330\247\333\214 \331\207\331\210\330\264\331\205\331\206\330\257 \331\210 \330\263\330\247\333\214\330\250\330\247\331\206\n              </span>\n            </div>\n            <div className=\"p-6 sm:p-7 flex-1 flex flex-col justify-between gap-5\">\n              <div className=\"space-y-2.5\">\n                <div className=\"flex items-center gap-2 text-xs text-[#565E74]\">\n                  <span className=\"font-tech\">EL-SP350</span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>\330\250\330\247\330\261 \330\250\330\261\331\201 \330\252\330\247 \333\262.\333\265 \332\251\333\214\331\204\331\210\331\206\333\214\331\210\330\252\331\206</span>\n                </div>\n                <h3 className=\"text-xl font-bold text-[#0F172A]\">\n                  \330\263\330\247\333\214\330\250\330\247\331\206 \331\205\330\271\331\204\331\202 \330\247\330\263\331\276\330\247\333\214\330\257\330\261 \331\210 \330\264\333\214\330\264\331\207 \330\263\330\247\330\262\331\207\342\200\214\330\247\333\214\n                </h3>\n                <p className=\"text-sm text-[#334155] leading-7\">\n                  \332\251\331\206\330\263\331\210\331\204\342\200\214\331\207\330\247\333\214 \331\210\330\261\331\210\330\257\333\214 \330\252\331\205\330\247\331\205\342\200\214\330\264\333\214\330\264\331\207 \330\250\330\247 \331\205\331\207\330\247\330\261\332\251\330\264 \330\247\330\263\330\252\333\214\331\204 \333\263\333\261\333\266 \331\210 \330\257\331\201\330\252\330\261\332\206\331\207 \331\205\330\255\330\247\330\263\330\250\330\247\330\252 \330\257\331\202\333\214\331\202 \330\250\330\261\330\247\333\214\n                  \330\263\330\247\330\256\330\252\331\205\330\247\331\206\342\200\214\331\207\330\247\333\214 \330\247\330\257\330\247\330\261\333\214 \331\210 \331\207\330\252\331\204\342\200\214\331\207\330\247.\n                </p>\n              </div>\n              <div className=\"flex items-center justify-between pt-3 border-t border-slate-100\">\n                <span className=\"text-xs text-[#565E74] tabular-nums\">\n                  \330\264\330\261\331\210\330\271 \330\247\330\262 <strong className=\"text-[#0F172A]\">{formatToman(24_800_000)}</strong> / \331\205\330\252\330\261\331\205\330\261\330\250\330\271\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenCategory(\'smart-facades\')}\n                  className=\"inline-flex items-center gap-1.5 text-sm font-semibold text-[#006C49] hover:text-[#059669] cursor-pointer\"\n                >\n                  <span>\330\250\330\261\330\261\330\263\333\214 \331\205\330\257\331\204\342\200\214\331\207\330\247</span>\n                  <ArrowLeft className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          </article>\n\n          {/* Card 4: Electric Polycarbonate Shutters (Wide) */}\n          <article className=\"lg:col-span-7 surface-card-2 rounded-[28px] overflow-hidden flex flex-col\">\n            <div className=\"relative aspect-[16/1