      arguments_json: "{\"CodeContent\":\"import { ArrowLeft, Calculator, Trash2 } from \'lucide-react\';\\nimport { formatPersianNumber, formatToman, type QuoteItem } from \'../data/catalog\';\\n\\ninterface StickyQuoteBarProps {\\n  items: QuoteItem[];\\n  onOpenEstimator: () => void;\\n  onClear: () => void;\\n}\\n\\nexport function StickyQuoteBar({ items, onOpenEstimator, onClear }: StickyQuoteBarProps) {\\n  if (items.length === 0) return null;\\n\\n  const totalToman = items.reduce((acc, item) => acc + item.estimatedPriceToman, 0);\\n\\n  return (\\n    <div className=\\\"fixed bottom-4 inset-x-4 z-30 pointer-events-none\\\">\\n      <div className=\\\"max-w-[960px] mx-auto glass-surface rounded-full px-5 sm:px-6 py-3 flex items-center justify-between gap-4 pointer-events-auto\\\">\\n        <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n          <div className=\\\"w-10 h-10 rounded-full bg-[#10B981]/12 text-[#006C49] flex items-center justify-center shrink-0\\\">\\n            <Calculator className=\\\"w-4 h-4\\\" />\\n          </div>\\n          <div className=\\\"min-w-0\\\">\\n            <div className=\\\"text-xs sm:text-sm font-bold text-[#0F172A] truncate\\\">\\n              {formatPersianNumber(items.length)} \330\263\333\214\330\263\330\252\331\205 \330\257\330\261 \331\204\333\214\330\263\330\252 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261 \331\276\330\261\331\210\332\230\331\207\\n            </div>\\n            <div className=\\\"text-xs text-[#334155] tabular-nums truncate\\\">\\n              \330\250\330\261\330\242\331\210\330\261\330\257 \330\252\331\202\330\261\333\214\330\250\333\214: <strong className=\\\"text-[#006C49]\\\">{formatToman(totalToman)}</strong>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClear}\\n            className=\\\"w-9 h-9 rounded-full text-slate-500 hover:text-rose-600 hover:bg-rose-50 inline-flex items-center justify-center transition-colors cursor-pointer\\\"\\n            aria-label=\\\"\331\276\330\247\332\251 \332\251\330\261\330\257\331\206 \331\204\333\214\330\263\330\252 \330\250\330\261\330\242\331\210\330\261\330\257\\\"\\n            title=\\\"\331\276\330\247\332\251 \332\251\330\261\330\257\331\206 \331\204\333\214\330\263\330\252 \330\250\330\261\330\242\331\210\330\261\330\257\\\"\\n          >\\n            <Trash2 className=\\\"w-4 h-4\\\" />\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenEstimator}\\n            className=\\\"btn-primary-elessa rounded-full px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold inline-flex items-center gap-2 whitespace-nowrap cursor-pointer\\\"\\n          >\\n            <span>\330\252\332\251\331\205\333\214\331\204 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261</span>\\n            <ArrowLeft className=\\\"w-4 h-4 shrink-0\\\" />\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create Level 3 glassmorphic sticky quotation bar for queued architectural systems\", \"Overwrite\":true, \"TargetFile\":\"/src/components/StickyQuoteBar.tsx\", \"toolAction\":\"Creating StickyQuoteBar component\", \"toolSummary\":\"Create glassmorphic sticky quote bar\"}"
      original_name: "write_to_file"
