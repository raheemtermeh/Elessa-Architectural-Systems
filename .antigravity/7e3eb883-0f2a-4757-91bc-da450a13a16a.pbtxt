            lines {
              text: "      \'\330\252\330\261\332\251\333\214\330\250 \332\251\330\261\332\251\330\261\331\207 \330\247\331\205\331\206\333\214\330\252\333\214 \330\252\331\205\330\247\331\205\342\200\214\330\264\331\201\330\247\331\201 \331\276\331\204\333\214\342\200\214\332\251\330\261\330\250\331\206\330\247\330\252 \330\250\330\247 \330\261\333\214\331\204\342\200\214\331\207\330\247\333\214 \331\205\330\256\331\201\333\214 \330\257\330\261 \331\202\330\247\330\250 \330\263\331\206\332\257 \331\210 \330\263\330\247\333\214\330\250\330\247\331\206 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \332\251\331\206\330\263\331\210\331\204\333\214 \330\250\330\247 \333\214\330\261\330\247\331\202\342\200\214\330\242\331\204\330\247\330\252 \330\247\330\263\330\252\333\214\331\204 \333\263\333\261\333\266.\',"
