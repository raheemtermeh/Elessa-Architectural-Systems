  code_action {
    action_spec {
      create_file {
        instruction: "import { useState } from \'react\';\nimport {\n  calculateProductEstimate,\n  type ArchitecturalProduct,\n  type CategoryId,\n  type QuoteItem,\n} from \'./data/catalog\';\nimport { Header, type ScreenId } from \'./components/Header\';\nimport { HomeScreen } from \'./components/HomeScreen\';\nimport { CatalogScreen } from \'./components/CatalogScreen\';\nimport { ProjectsScreen } from \'./components/ProjectsScreen\';\nimport { EstimatorScreen } from \'./components/EstimatorScreen\';\nimport { ProductDetailModal } from \'./components/ProductDetailModal\';\nimport { StickyQuoteBar } from \'./components/StickyQuoteBar\';\nimport { Footer } from \'./components/Footer\';\n\nexport default function App() {\n  const [activeScreen, setActiveScreen] = useState<ScreenId>(\'home\');\n  const [selectedCategory, setSelectedCategory] = useState<CategoryId>(\'all\');\n  const [inspectedProduct, setInspectedProduct] = useState<ArchitecturalProduct | null>(null);\n  const [quoteItems, setQuoteItems] = useState<QuoteItem[]>([]);\n\n  const handleAddQuoteItem = (item: QuoteItem) => {\n    setQuoteItems((prev) => [...prev, item]);\n  };\n\n  const handleQuickAddProduct = (product: ArchitecturalProduct) => {\n    const finish = product.finishes[0];\n    const calc = calculateProductEstimate({\n      product,\n      widthMeters: product.defaultWidth,\n      heightMeters: product.defaultHeight,\n      finishMultiplier: finish.multiplier,\n      glassMultiplier: 1.0,\n      gradeMultiplier: 1.0,\n      quantity: 1,\n    });\n\n    handleAddQuoteItem({\n      id: `${product.id}-${Date.now()}`,\n      productId: product.id,\n      modelCode: product.modelCode,\n      name: product.name,\n      categoryLabel: product.categoryLabel,\n      finishLabel: finish.label,\n      glassSpec: \'\330\264\333\214\330\264\331\207 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \331\204\331\205\333\214\331\206\330\252 / \330\263\332\251\331\210\330\261\333\214\330\252\',\n      widthMeters: product.defaultWidth,\n      heightMeters: product.defaultHeight,\n      quantity: 1,\n      estimatedWeightKg: calc.estimatedWeightKg,\n      estimatedPriceToman: calc.totalPriceToman,\n    });\n  };\n\n  const handleRemoveQuoteItem = (id: string) => {\n    setQuoteItems((prev) => prev.filter((item) => item.id !== id));\n  };\n\n  const handleClearQuoteItems = () => {\n    setQuoteItems([]);\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-[#FAFCFB] text-[#0F172A]\">\n      <Header\n        activeScreen={activeScreen}\n        onNavigate={setActiveScreen}\n        quoteCount={quoteItems.length}\n      />\n\n      <main className=\"flex-1\">\n        {activeScreen === \'home\' && (\n          <HomeScreen\n            onNavigate={setActiveScreen}\n            onSelectCategory={setSelectedCategory}\n            onInspectProduct={setInspectedProduct}\n          />\n        )}\n\n        {activeScreen === \'catalog\' && (\n          <CatalogScreen\n            selectedCategory={selectedCategory}\n            onSelectCategory={setSelectedCategory}\n            onInspectProduct={setInspectedProduct}\n            onQuickAddToQuote={handleQuickAddProduct}\n          />\n        )}\n\n        {activeScreen === \'projects\' && <ProjectsScreen onNavigate={setActiveScreen} />}\n\n        {activeScreen === \'estimator\' && (\n          <EstimatorScreen\n            quoteItems={quoteItems}\n            onAddQuoteItem={handleAddQuoteItem}\n            onRemoveQuoteItem={handleRemoveQuoteItem}\n            onClearQuoteItems={handleClearQuoteItems}\n          />\n        )}\n      </main>\n\n      <Footer onNavigate={setActiveScreen} />\n\n      {activeScreen !== \'estimator\' && (\n        <StickyQuoteBar\n          items={quoteItems}\n          onOpenEstimator={() => {\n            setActiveScreen(\'estimator\');\n            window.scrollTo({ top: 0, behavior: \'smooth\' });\n          }}\n          onClear={handleClearQuoteItems}\n        />\n      )}\n\n      <ProductDetailModal\n        product={inspectedProduct}\n        onClose={() => setInspectedProduct(null)}\n        onAddConfiguredQuote={handleAddQuoteItem}\n      />\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }
