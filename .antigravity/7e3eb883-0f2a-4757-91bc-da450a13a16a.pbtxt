       <div className=\\\"lg:col-span-6 relative\\\">\\n            <div className=\\\"relative h-full min-h-[320px] sm:min-h-[420px] lg:min-h-[470px] rounded-[32px] overflow-hidden border border-white shadow-[0_20px_50px_-12px_rgba(15,23,42,0.12)]\\\">\\n              <ResilientImage\\n                src={IMAGES.heroEntrance}\\n                alt=\\\"\331\210\330\261\331\210\330\257\333\214 \330\257\330\261\330\250 \330\247\330\252\331\210\331\205\330\247\330\252\333\214\332\251 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \330\250\330\257\331\210\331\206 \331\201\330\261\333\214\331\205 \330\247\331\204\330\263\330\247 \330\257\330\261 \331\204\330\247\330\250\333\214 \331\205\330\257\330\261\331\206\\\"\\n                className=\\\"w-full h-full object-cover\\\"\\n              />\\n              <div\\n                aria-hidden=\\\"true\\\"\\n                className=\\\"absolute inset-0 bg-gradient-to-t from-[#0F172A]/60 via-transparent to-transparent\\\"\\n              />\\n\\n              {/* Frosted Glass Architectural Spec Overlay */}\\n              <div className=\\\"absolute bottom-5 inset-x-5 sm:inset-x-6 glass-surface rounded-2xl p-4 sm:px-5 flex items-center justify-between gap-4\\\">\\n                <div className=\\\"min-w-0\\\">\\n                  <div className=\\\"text-xs text-[#565E74]\\\">\330\263\330\261\333\214 \331\276\330\261\332\206\331\205\330\257\330\247\330\261 \331\210\330\261\331\210\330\257\333\214 \331\207\331\210\330\264\331\205\331\206\330\257</div>\\n                  <div className=\\\"text-sm sm:text-base font-bold text-[#0F172A] truncate\\\">\\n                    \330\257\330\261\330\250 \330\247\330\263\331\204\330\247\333\214\330\257\333\214\331\206\332\257 \330\257\331\210 \331\204\330\252 <span className=\\\"font-tech text-[#006C49]\\\">EL-SL420</span>\\n                  </div>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onInspectProduct(PRODUCTS[0])}\\n                  className=\\\"rounded-full bg-[#0F172A] text-white hover:bg-[#006C49] transition-colors px-4 py-2 text-xs font-semibold whitespace-nowrap shrink-0 cursor-pointer\\\"\\n                >\\n                  \330\254\330\262\330\246\333\214\330\247\330\252 \331\201\331\206\333\214\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Full-Width 4-Column Engineering Metrics Strip Directly Below Hero Split */}\\n        <div className=\\\"mt-10 surface-card-1 rounded-[28px] p-6 sm:p-8 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8\\\">\\n          {ENGINEERING_METRICS.map((metric, idx) => (\\n            <div\\n              key={metric.value}\\n              className={`${\\n                idx !== 0 ? \'lg:border-r lg:border-slate-200/80 lg:pr-8\' : \'\'\\n              } space-y-1.5`}\\n            >\\n              <div className=\\\"text-2xl sm:text-3xl font-extrabold text-[#0F172A] tabular-nums tracking-tight\\\">\\n                {metric.value}\\n              </div>\\n              <p className=\\\"text-xs sm:text-[13px] text-[#565E74] leading-6\\\">{metric.label}</p>\\n            </div>\\n          ))}\\n        </div>\\n      </section>\\n\\n      {/* Asymmetric Architectural Divisions Bento Showcase */}\\n      <section className=\\\"max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 space-y-8\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n          <div className=\\\"space-y-2 max-w-2xl\\\">\\n            <p className=\\\"text-xs font-semibold text-[#006C49]\\\">\332\257\330\261\331\210\331\207\342\200\214\331\207\330\247\333\214 \330\252\330\256\330\265\330\265\333\214 \331\205\330\255\330\265\331\210\331\204\330\247\330\252</p>\\n            <h2 className=\\\"text-2xl sm:text-[32px] font-bold text-[#0F172A]\\\">\\n              \332\206\331\207\330\247\330\261 \330\263\330\252