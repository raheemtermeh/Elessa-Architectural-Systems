      create_file {
        instruction: "export type CategoryId =\n  | \'all\'\n  | \'automatic-doors\'\n  | \'glass-railings\'\n  | \'smart-facades\'\n  | \'electric-shutters\';\n\nexport type ApplicationId = \'all\' | \'commercial\' | \'corporate\' | \'residential\' | \'healthcare\';\n\nexport interface FinishOption {\n  id: string;\n  label: string;\n  code: string;\n  swatch: string;\n  multiplier: number;\n}\n\nexport interface TechnicalSpec {\n  label: string;\n  value: string;\n  unit?: string;\n}\n\nexport interface ArchitecturalProduct {\n  id: string;\n  modelCode: string;\n  name: string;\n  shortTitle: string;\n  category: Exclude<CategoryId, \'all\'>;\n  categoryLabel: string;\n  applications: Exclude<ApplicationId, \'all\'>[];\n  applicationLabel: string;\n  image: string;\n  summary: string;\n  engineeringNote: string;\n  pricingUnit: \'opening\' | \'linear-meter\' | \'square-meter\';\n  pricingUnitLabel: string;\n  basePriceToman: number;\n  defaultWidth: number;\n  defaultHeight: number;\n  standardCode: string;\n  warrantyYears: number;\n  leadTimeDays: string;\n  highlights: string[];\n  specs: TechnicalSpec[];\n  finishes: FinishOption[];\n}\n\nexport interface ArchitecturalProject {\n  id: string;\n  title: string;\n  location: string;\n  year: string;\n  category: Exclude<CategoryId, \'all\'>;\n  categoryLabel: string;\n  clientType: string;\n  image: string;\n  areaOrCount: string;\n  deliveryDays: string;\n  systemsUsed: string[];\n  outcomeMetric: string;\n  overview: string;\n  engineeringChallenge: string;\n  testimonial: {\n    quote: string;\n    author: string;\n    role: string;\n    organization: string;\n  };\n}\n\nexport interface QuoteItem {\n  id: string;\n  productId: string;\n  modelCode: string;\n  name: string;\n  categoryLabel: string;\n  finishLabel: string;\n  glassSpec: string;\n  widthMeters: number;\n  heightMeters: number;\n  quantity: number;\n  estimatedWeightKg: number;\n  estimatedPriceToman: number;\n}\n\nexport const IMAGES = {\n  h