  code_action {
    action_spec {
      create_file {
        instruction: "import { MapPin, Phone, Mail, Clock } from \'lucide-react\';\nimport type { ScreenId } from \'./Header\';\n\ninterface FooterProps {\n  onNavigate: (screen: ScreenId) => void;\n}\n\nexport function Footer({ onNavigate }: FooterProps) {\n  const handleNav = (screen: ScreenId) => {\n    onNavigate(screen);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"bg-[#0F172A] text-slate-200 mt-20\">\n      <div className=\"max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-14 lg:py-16\">\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-slate-800\">\n          {/* Brand Column */}\n          <div className=\"md:col-span-5 space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-2xl font-extrabold text-white tracking-tight\">\330\247\331\204\330\263\330\247</span>\n              <span className=\"text-xs font-latin tracking-wider text-[#4EDEA3] uppercase\">\n                Elessa Architectural Systems\n              </span>\n            </div>\n            <p className=\"text-sm text-slate-300 leading-7 max-w-md\">\n              \330\267\330\261\330\247\330\255\333\214 \331\205\331\207\331\206\330\257\330\263\333\214\330\214 \330\252\330\243\331\205\333\214\331\206 \331\210 \330\247\330\254\330\261\330\247\333\214 \330\252\330\256\330\265\330\265\333\214 \330\257\330\261\330\250\342\200\214\331\207\330\247\333\214 \330\247\330\252\331\210\331\205\330\247\330\252\333\214\332\251 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214\330\214 \330\263\333\214\330\263\330\252\331\205\342\200\214\331\207\330\247\333\214 \331\206\330\261\330\257\331\207 \331\210\n              \331\207\331\206\330\257\330\261\333\214\331\204 \330\257\331\201\331\206\333\214 \331\210 \330\247\332\251\330\263\331\276\331\210\330\262\330\214 \331\206\331\205\330\247\333\214 \331\207\331\210\330\264\331\205\331\206\330\257 \330\247\330\263\331\276\330\247\333\214\330\257\330\261 \331\210 \332\251\330\261\332\251\330\261\331\207\342\200\214\331\207\330\247\333\214 \330\264\331\201\330\247\331\201 \331\276\331\204\333\214\342\200\214\332\251\330\261\330\250\331\206\330\247\330\252 \330\250\330\261\330\247\333\214\n              \331\276\330\261\331\210\332\230\331\207\342\200\214\331\207\330\247\333\214 \331\205\330\271\331\205\330\247\330\261\333\214 \330\264\330\247\330\256\330\265.\n            </p>\n            <div className=\"pt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-400 font-tech\">\n              <span>EN 16005</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>DIN 18650</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>DIN 18008-4</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>ISO 9001:2015</span>\n            </div>\n          </div>\n\n          {/* Quick Links */}\n          <div className=\"md:col-span-3 space-y-4\">\n            <h3 className=\"text-sm font-bold text-white\">\330\250\330\256\330\264\342\200\214\331\207\330\247\333\214 \330\263\330\247\331\205\330\247\331\206\331\207</h3>\n            <ul className=\"space-y-2.5 text-sm text-slate-300\">\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleNav(\'home\')}\n                  className=\"hover:text-[#4EDEA3] transition-colors cursor-pointer\"\n                >\n                  \330\265\331\201\330\255\331\207 \330\247\330\265\331\204\333\214 \331\210 \331\205\330\271\330\261\331\201\333\214\n                </button>\n              </li>\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleNav(\'catalog\')}\n                  className=\"hover:text-[#4EDEA3] transition-colors cursor-pointer\"\n                >\n                  \332\251\330\247\330\252\330\247\331\204\331\210\332\257 \331\210 \331\205\330\264\330\256\330\265\330\247\330\252 \331\201\331\206\333\214\n                </button>\n              </li>\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleNav(\'projects\')}\n                  className=\"hover:text-[#4EDEA3] transition-colors cursor-pointer\"\n                >\n                  \331\276\330\261\331\210\332\230\331\207\342\200\214\331\207\330\247\333\214 \330\247\330\254\330\261\330\247\330\264\330\257\331\207\n                </button>\n              </li>\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleNav(\'estimator\')}\n                  className=\"hover:text-[#4EDEA3] transition-colors cursor-pointer\"\n                >\n                  \331\205\330\255\330\247\330\263\330\250\331\207\342\200\214\332\257\330\261 \331\207\331\210\330\264\331\205\331\206\330\257 \331\210 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Contact Details */}\n          <div className=\"md:col-span-4 space-y-4\">\n            <h3 className=\"text-sm font-bold text-white\">\330\264\331\210\330\261\331\210\331\205 \331\210 \330\257\331\201\330\252\330\261 \331\205\331\207\331\206\330\257\330\263\333\214</h3>\n            <ul className=\"space-y-3 text-sm text-slate-300\">\n              <li className=\"flex items-start gap-3\">\n                <MapPin className=\"w-4 h-4 text-[#10B981] mt-1 shrink-0\" />\n                <span>\330\252\331\207\330\261\330\247\331\206\330\214 \330\256\333\214\330\247\330\250\330\247\331\206 \331\201\330\261\330\264\330\252\331\207\330\214 \331\276\331\204\330\247\332\251 \333\264\333\270\330\214 \330\267\330\250\331\202\331\207 \330\257\331\210\331\205\330\214 \331\210\330\247\330\255\330\257 \331\20