      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useMemo, useState } from \'react\';\\nimport { ArrowLeft, Plus, Search, SlidersHorizontal } from \'lucide-react\';\\nimport {\\n  APPLICATIONS,\\n  CATEGORIES,\\n  PRODUCTS,\\n  formatPersianNumber,\\n  formatToman,\\n  type ApplicationId,\\n  type ArchitecturalProduct,\\n  type CategoryId,\\n} from \'../data/catalog\';\\nimport { ResilientImage } from \'./ResilientImage\';\\n\\ninterface CatalogScreenProps {\\n  selectedCategory: CategoryId;\\n  onSelectCategory: (category: CategoryId) => void;\\n  onInspectProduct: (product: ArchitecturalProduct) => void;\\n  onQuickAddToQuote: (product: ArchitecturalProduct) => void;\\n}\\n\\nexport function CatalogScreen({\\n  selectedCategory,\\n  onSelectCategory,\\n  onInspectProduct,\\n  onQuickAddToQuote,\\n}: CatalogScreenProps) {\\n  const [selectedApplication, setSelectedApplication] = useState<ApplicationId>(\'all\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n\\n  const filteredProducts = useMemo(() => {\\n    const q = searchQuery.trim().toLowerCase();\\n    return PRODUCTS.filter((product) => {\\n      const matchesCategory =\\n        selectedCategory === \'all\' || product.category === selectedCategory;\\n      const matchesApp =\\n        selectedApplication === \'all\' || product.applications.includes(selectedApplication);\\n      const matchesSearch =\\n        !q ||\\n        product.name.toLowerCase().includes(q) ||\\n        product.modelCode.toLowerCase().includes(q) ||\\n        product.summary.toLowerCase().includes(q) ||\\n        product.categoryLabel.toLowerCase().includes(q);\\n      return matchesCategory && matchesApp && matchesSearch;\\n    });\\n  }, [selectedCategory, selectedApplication, searchQuery]);\\n\\n  const activeCategoryMeta =\\n    CATEGORIES.find((c) => c.id === selectedCategory) || CATEGORIES[0];\\n\\n  return (\\n    <div className=\\\"max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-8 lg:py-12 space-y-10\\\">\\n      {/* Screen Header */}\\n      <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-6\\\">\\n        <div className=\\\"space-y-2.5 max-w-2xl\\\">\\n          <p className=\\\"text-xs font-semibold text-[#006C49]\\\">\332\251\330\247\330\252\330\247\331\204\331\210\332\257 \331\205\331\207\331\206\330\257\330\263\333\214 \331\205\330\255\330\265\331\210\331\204\330\247\330\252</p>\\n          <h1 className=\\\"text-[28px] sm:text-[36px] font-extrabold text-[#0F172A] tracking-tight\\\">\\n            {activeCategoryMeta.label}\\n          </h1>\\n          <p className=\\\"text-sm sm:text-[15px] text-[#334155] leading-7\\\">\\n            {activeCategoryMeta.shortDesc} \342\200\224 \331\205\330\264\330\256\330\265\330\247\330\252 \331\201\331\206\333\214 \330\257\331\202\333\214\331\202\330\214 \330\254\330\257\331\210\331\204 \330\250\330\247\330\261\332\257\330\260\330\247\330\261\333\214 \331\210 \330\247\331\206\330\252\330\256\330\247\330\250 \330\261\331\206\332\257 \331\276\330\261\331\210\331\201\333\214\331\204\\n            \330\250\330\261\330\247\333\214 \331\207\330\261 \330\263\333\214\330\263\330\252\331\205.\\n          </p>\\n        </div>\\n\\n        {/* Search & Application Filter Controls */}\\n        <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto\\\">\\n          <div className=\\\"relative flex-1 sm:w-64\\\">\\n            <Search className=\\\"w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n            <input\\n              type=\\\"search\\\"\\n              value={searchQuery}\\n              onChange={(e) => setSearchQuery(e.target.value)}\\n              placeholder=\\\"\330\254\330\263\330\252\330\254\331\210\333\214 \331\205\330\257\331\204 (\331\205\330\253\331\204\330\247\331\213 EL-SL420)...\\\"\\n              className=\\\"input-elessa w-full pr-10 pl-4 py-2.5 text-sm\\\"\\n              aria-label=\\\"\330\254\330\263\330\252\330\254\331\210 \330\257\330\261 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"relative sm:w-52\\\">\\n            <SlidersHorizontal className=\\\"w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n            <select\\n              value={selectedApplication}\\n              onChange={(e) => setSelectedApplication(e.target.value as ApplicationId)}\\n              aria-label=\\\"\331\201\333\214\331\204\330\252\330\261 \330\250\330\261 \330\247\330\263\330\247\330\263 \332\251\330\247\330\261\330\250\330\261\333\214 \330\263\330\247\330\256\330\252\331\205\330\247\331\206\\\"\\n              className=\\\"input-elessa w-full pr-10 pl-4 py-2.5 text-sm appearance-none cursor-pointer\\\"\\n            >\\n              {APPLICATIONS.map((app) => (\\n                <option key={app.id} value={app.id}>\\n                  {app.label}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Category Filter Chips matching Spec */}\\n      <div\\n        role=\\\"tablist\\\"\\n        aria-label=\\\"\331\201\333\214\331\204\330\252\330\261 \330\257\330\263\330\252\331\207\342\200\214\330\250\331\206\330\257\333\214 \330\263\333\214\330\263\330\252\331\205\342\200\214\331\207\330\247\\\"\\n        className=\\\"flex items-center gap-2.5 overflow-x-auto pb-2\\\"\\n      >\\n        {CATEGORIES.map((category) => {\\n          const isActive = selectedCategory === category.id;\\n          return (\\n            <button\\n              key={category.id}\\n              type=\\\"button\\\"\\n              role=\\\"tab\\\"\\n              aria-selected={isActive}\\n              onClick={() => onSelectCategory(category.id)}\\n              className={`rounded-full px-5 py-2.5 text-xs sm:text-sm font-semibold whitespace-nowrap shrink-0 transition-all cursor-pointer ${\\n                isActive\\n                  ? \'chip-active-elessa\'\\n                  : \'bg-[#F1F5F9] text-[#565E74] hover:bg-slate-200/80 hover:text-[#0F172A]\'\\n              }`}\\n            >\\n              {category.label}\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {/* Results Count */}\\n      <div className=\\\"flex items-center justify-between text-xs text-[#565E74] border-b border-slate-200/70 pb-3\\\">\\n        <span>\\n          \331\206\331\205\330\247\333\214\330\264{\' \'}\\n          <strong className=\\\"text-[#0F172A] tabular-nums\\\">\\n            {formatPersianNumber(filteredProducts.length)}\\n          </strong>{\' \'}\\n          \330\263\333\214\330\263\330\252\331\205 \331\205\330\271\331\205\330\247\330\261\333\214\\n        </span>\\n        {(selectedCategory !== \'all\' || selectedApplication !== \'all\' || searchQuery) && (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              onSelectCategory(\'all\');\\n              setSelectedApplication(\'all\');\\n              setSearchQuery(\'\');\\n            }}\\n            className=\\\"text-[#006C49] hover:underline font-medium cursor-pointer\\\"\\n          >\\n            \331\276\330\247\332\251 \332\251\330\261\330\257\331\206 \331\201\333\214\331\204\330\252\330\261\331\207\330\247\\n          </button>\\n        )}\\n      </div>\\n\\n      {/* Product Grid */}\\n      {filteredProducts.length === 0 ? (\\n        <div className=\\\"surface-card-1 rounded-[28px] p-12 text-center space-y-4\\\">\\n          <p className=\\\"text-base font-bold text-[#0F172A]\\\">\\n            \331\205\330\255\330\265\331\210\331\204\333\214 \331\205\330\267\330\247\330\250\331\202 \330\250\330\247 \331\201\333\214\331\204\330\252\330\261 \330\247\331\206\330\252\330\256\330\247\330\250\342\200\214\330\264\330\257\331\207 \333\214\330\247\331\201\330\252 \331\206\330\264\330\257.\\n          </p>\\n          <p className=\\\"text-sm text-[#565E74]\\\">\\n            \330\271\330\250\330\247\330\261\330\252 \330\254\330\263\330\252\330\254\331\210 \330\261\330\247 \330\252\330\272\333\214\333\214\330\261 \330\257\331\207\333\214\330\257 \333\214\330\247 \331\201\333\214\331\204\330\252\330\261 \332\251\330\247\330\261\330\250\330\261\333\214 \331\210 \330\257\330\263\330\252\331\207\342\200\214\330\250\331\206\330\257\333\214 \330\261\330\247 \330\250\330\247\330\262\331\206\330\264\330\247\331\206\333\214 \332\251\331\206\333\214\330\257.\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              onSelectCategory(\'all\');\\n              setSelectedApplication(\'all\');\\n              setSearchQuery(\'\');\\n            }}\\n            className=\\\"btn-secondary-elessa rounded-full px-6 py-2.5 text-sm font-semibold cursor-pointer\\\"\\n          >\\n            \331\206\331\205\330\247\333\214\330\264 \331\207\331\205\331\207 \330\263\333\214\330\263\330\252\331\205\342\200\214\331\207\330\247\\n          </button>\\n        </div>\\n      ) : (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 lg:gap-8\\\">\\n          {filteredProducts.map((product) => (\\n            <article\\n              key={product.id}\\n              className=\\\"surface-card-2 rounded-[28px] overflow-hidden flex flex-col\\\"\\n            >\\n              {/* 16:10 Visual Preview with Floating Frosted Category Badge */}\\n              <div className=\\\"relative aspect-[16/10] overflow-hidden bg-slate-100\\\">\\n                <ResilientImage\\n                  src={product.image}\\n                  alt={product.name}\\n                  className=\\\"w-full h-full object-cover transition-transform duration-300 hover:scale-[1.03]\\\"\\n                />\\n                <span className=\\\"absolute top-3.5 right-3.5 glass-surface rounded-full px-3.5 py-1 text-[11px] font-semibold text-[#0F172A]\\\">\\n                  {product.categoryLabel}\\n                </span>\\n              </div>\\n\\n              {/* Card Body */}\\n              <div className=\\\"p-6 flex-1 flex flex-col justify-between gap-5\\\">\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between gap-2 text-xs text-[#565E74]\\\">\\n                    <span className=\\\"font-tech font-semibold text-[#006C49]\\\">\\n                      {product.modelCode}\\n                    </span>\\n                    <span className=\\\"truncate\\\">{product.standardCode}</span>\\n                  </div>\\n\\n                  <h2 className=\\\"text-lg font-bold text-[#0F172A] leading-snug\\\">\\n                    {product.name}\\n                  </h2>\\n\\n                  <p className=\\\"text-[13px] text-[#334155] leading-6\\\">{product.summary}</p>\\n\\n                  {/* Compact Key Technical Highlights (Inline Zebra Preview) */}\\n                  <div className=\\\"pt-2 space-y-1.5 border-t border-slate-100\\\">\\n                    {product.specs.slice(0, 2).map((spec) => (\\n                      <div\\n                        key={spec.label}\\n                        className=\\\"flex items-center justify-between gap-3 text-xs\\\"\\n                      >\\n                        <span className=\\\"text-[#565E74] truncate\\\">{spec.label}</span>\\n                        <span\\n                          dir=\\\"ltr\\\"\\n                          className=\\\"font-tech font-medium text-[#0F172A] whitespace-nowrap shrink-0\\\"\\n                        >\\n                          {spec.value} {spec.unit || \'\'}\\n                        </span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                </div>\\n\\n                {/* Price & Actions */}\\n                <div className=\\\"pt-4 border-t border-slate-100 space-y-3.5\\\">\\n                  <div className=\\\"flex items-baseline justify-between gap-2\\\">\\n                    <span className=\\\"text-xs text-[#565E74]\\\">{product.pricingUnitLabel}</span>\\n                    <span className=\\\"text-sm font-extrabold text-[#0F172A] tabular-nums\\\">\\n                      {formatToman(product.basePriceToman)}\\n                    </span>\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onInspectProduct(product)}\\n                      className=\\\"btn-secondary-elessa rounded-full px-4 py-2.5 text-xs font-semibold inline-flex items-center justify-center gap-1.5 whitespace-nowrap cursor-pointer\\\"\\n                    >\\n                      <span>\331\205\330\264\330\256\330\265\330\247\330\252 \331\201\331\206\333\214</span>\\n                      <ArrowLeft className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n                    </button>\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onQuickAddToQuote(product)}\\n                      className=\\\"btn-primary-elessa rounded-full px-4 py-2.5 text-xs font-bold inline-flex items-center justify-center gap-1.5 whitespace-nowrap cursor-pointer\\\"\\n                    >\\n                      <Plus className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n                      <span>\330\247\331\201\330\262\331\210\330\257\331\206 \330\250\331\207 \330\250\330\261\330\242\331\210\330\261\330\257</span>\\n                    </button>\\n                  </div>\\n                </div>\\n              </div>\\n            </article>\\n          ))}\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create CatalogScreen with pill category filters, application select, search, and 16:10 rounded-[28px] product cards\", \"Overwrite\":true, \"TargetFile\":\"/src/components/CatalogScreen.tsx\", \"toolAction\":\"Creating CatalogScreen component\", \"toolSummary\":\"Create CatalogScreen component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11352798008599189150"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useState } from \'react\';\\nimport { Check, Plus, ShieldCheck, X } from \'lucide-react\';\\nimport {\\n  calculateProductEstimate,\\n  formatPersianNumber,\\n  formatToman,\\n  type ArchitecturalProduct,\\n  type QuoteItem,\\n} from \'../data/catalog\';\\nimport { ResilientImage } from \'./ResilientImage\';\\n\\ninterface ProductDetailModalProps {\\n  product: ArchitecturalProduct | null;\\n  onClose: () => void;\\n  onAddConfiguredQuote: (item: QuoteItem) => void;\\n}\\n\\nexport function ProductDetailModal({\\n  product,\\n  onClose,\\n  onAddConfiguredQuote,\\n}: ProductDetailModalProps) {\\n  const [selectedFinishId, setSelectedFinishId] = useState<string>(\'\');\\n  const [widthMeters, setWidthMeters] = useState<number>(3.2);\\n  const [heightMeters, setHeightMeters] = useState<number>(2.6);\\n  const [addedFeedback, setAddedFeedback] = useState(false);\\n\\n  useEffect(() => {\\n    if (product) {\\n      setSelectedFinishId(product.finishes[0]?.id || \'anodized-silver\');\\n      setWidthMeters(product.defaultWidth);\\n      setHeightMeters(product.defaultHeight);\\n      setAddedFeedback(false);\\n    }\\n  }, [product]);\\n\\n  useEffect(() => {\\n    if (!product) return;\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      if (e.key === \'Escape\') onClose();\\n    };\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\\n  }, [product, onClose]);\\n\\n  if (!product) return null;\\n\\n  const selectedFinish =\\n    product.finishes.find((f) => f.id === selectedFinishId) || product.finishes[0];\\n\\n  const estimate = calculateProductEstimate({\\n    product,\\n    widthMeters,\\n    heightMeters,\\n    finishMultiplier: selectedFinish.multiplier,\\n    glassMultiplier: 1.0,\\n    gradeMultiplier: 1.0,\\n    quantity: 1,\\n  });\\n\\n  const handleAdd = () => {\\n    onAddConfiguredQuote({\\n      id: `${product.id}-${Date.now()}`,\\n      productId: product.id,\\n      modelCode: product.modelCode,\\n      name: product.name,\\n      categoryLabel: product.categoryLabel,\\n      finishLabel: selectedFinish.label,\\n      glassSpec: \'\330\264\333\214\330\264\331\207 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \331\204\331\205\333\214\331\206\330\252 / \330\263\332\251\331\210\330\261\333\214\330\252\',\\n      widthMeters,\\n      heightMeters,\\n      quantity: 1,\\n      estimatedWeightKg: estimate.estimatedWeightKg,\\n      estimatedPriceToman: estimate.totalPriceToman,\\n    });\\n    setAddedFeedback(true);\\n    setTimeout(() => {\\n      setAddedFeedback(false);\\n    }, 1800);\\n  };\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"product-detail-title\\\"\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#0F172A]/45 backdrop-blur-sm overflow-y-auto\\\"\\n      onClick={onClose}\\n    >\\n      <div\\n        className=\\\"w-full max-w-4xl bg-white rounded-[32px] border border-white shadow-[0_24px_64px_-12px_rgba(15,23,42,0.28)] overflow-hidden my-auto max-h-[90vh] flex flex-col\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        {/* Top Modal Bar */}\\n        <div className=\\\"px-6 sm:px-8 py-5 border-b border-slate-100 flex items-center justify-between gap-4 shrink-0\\\">\\n          <div className=\\\"flex flex-wrap items-center gap-2.5 min-w-0\\\">\\n            <span className=\\\"font-tech text-xs font-semibold text-[#006C49] bg-[#10B981]/10 px-3 py-1 rounded-full\\\">\\n              {product.modelCode}\\n            </span>\\n            <span className=\\\"text-xs text-[#565E74]\\\">{product.categoryLabel}</span>\\n            <span aria-hidden=\\\"true\\\" className=\\\"text-slate-300\\\">\\n              \302\267\\n            </span>\\n            <span className=\\\"text-xs text-[#565E74] font-tech\\\">{product.standardCode}</span>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"w-9 h-9 rounded-full bg-[#F1F5F9] text-[#334155] hover:bg-slate-200 inline-flex items-center justify-center transition-colors cursor-pointer shrink-0\\\"\\n            aria-label=\\\"\330\250\330\263\330\252\331\206 \331\276\331\206\330\254\330\261\331\207 \331\205\330\264\330\256\330\265\330\247\330\252 \331\201\331\206\333\214\\\"\\n          >\\n            <X className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Scrollable Content */}\\n        <div className=\\\"overflow-y-auto p-6 sm:p-8 space-y-8\\\">\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-7 items-start\\\">\\n            {/* Image + Highlights */}\\n            <div className=\\\"lg:col-span-6 space-y-4\\\">\\n              <div className=\\\"aspect-[16/10] rounded-[24px] overflow-hidden border border-slate-200/70\\\">\\n                <ResilientImage\\n                  src={product.image}\\n                  alt={product.name}\\n                  className=\\\"w-full h-full object-cover\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"rounded-2xl bg-[#FAFCFB] border border-slate-200/70 p-4 space-y-2.5\\\">\\n                <div className=\\\"text-xs font-semibold text-[#006C49] flex items-center gap-1.5\\\">\\n                  <ShieldCheck className=\\\"w-4 h-4\\\" />\\n                  <span>\331\206\332\251\330\252\331\207 \331\205\331\207\331\206\330\257\330\263\333\214 \330\247\331\204\330\263\330\247</span>\\n                </div>\\n                <p className=\\\"text-xs sm:text-[13px] text-[#334155] leading-6\\\">\\n                  {product.engineeringNote}\\n                </p>\\n              </div>\\n            </div>\\n\\n            {/* Title, Finish Selector & Inline Quick Estimator */}\\n            <div className=\\\"lg:col-span-6 space-y-5\\\">\\n              <div className=\\\"space-y-2\\\">\\n                <h2\\n                  id=\\\"product-detail-title\\\"\\n                  className=\\\"text-xl sm:text-2xl font-extrabold text-[#0F172A]\\\"\\n                >\\n                  {product.name}\\n                </h2>\\n                <p className=\\\"text-sm text-[#334155] leading-7\\\">{product.summary}</p>\\n              </div>\\n\\n              {/* Finish Swatches */}\\n              <div className=\\\"space-y-2.5\\\">\\n                <div className=\\\"flex items-center justify-between text-xs\\\">\\n                  <span className=\\\"font-semibold text-[#0F172A]\\\">\331\276\331\210\330\264\330\264 \331\210 \330\261\331\206\332\257 \331\276\330\261\331\210\331\201\333\214\331\204:</span>\\n                  <span className=\\\"text-[#565E74]\\\">\\n                    {selectedFinish.label} ({selectedFinish.code})\\n                  </span>\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-2\\\">\\n                  {product.finishes.map((finish) => {\\n                    const active = finish.id === selectedFinish.id;\\n                    return (\\n                      <button\\n                        key={finish.id}\\n                        type=\\\"button\\\"\\n                        onClick={() => setSelectedFinishId(finish.id)}\\n                        className={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl border text-right text-xs font-medium transition-all cursor-pointer ${\\n                          active\\n                            ? \'border-[#10B981] bg-[#10B981]/5 text-[#006C49]\'\\n                            : \'border-slate-200 hover:border-slate-300 text-[#334155]\'\\n                        }`}\\n                      >\\n                        <span\\n                          aria-hidden=\\\"true\\\"\\n                          className=\\\"w-4 h-4 rounded-full border border-black/15 shrink-0\\\"\\n                          style={{ backgroundColor: finish.swatch }}\\n                        />\\n                        <span className=\\\"truncate\\\">{finish.label}</span>\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n              </div>\\n\\n              {/* Quick Dimension Adjuster */}\\n              <div className=\\\"rounded-2xl bg-[#F1F5F9]/75 p-4 space-y-4\\\">\\n                <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                  <label className=\\\"space-y-1.5 text-xs\\\">\\n                    <span className=\\\"block font-semibold text-[#0F172A]\\\">\\n                      {product.pricingUnit === \'linear-meter\' ? \'\330\267\331\210\331\204 \332\251\331\204 (\331\205\330\252\330\261)\' : \'\330\271\330\261\330\266 \330\257\331\207\330\247\331\206\331\207 (\331\205\330\252\330\261)\'}\\n                    </span>\\n                    <input\\n                      type=\\\"number\\\"\\n                      min={1}\\n                      max={30}\\n                      step={0.1}\\n                      dir=\\\"ltr\\\"\\n                      value={widthMeters}\\n                      onChange={(e) => setWidthMeters(Math.max(1, Number(e.target.value) || 1))}\\n                      className=\\\"input-elessa w-full px-3 py-2 text-sm font-tech text-left\\\"\\n                    />\\n                  </label>\\n                  <label className=\\\"space-y-1.5 text-xs\\\">\\n                    <span className=\\\"block font-semibold text-[#0F172A]\\\">\330\247\330\261\330\252\331\201\330\247\330\271 (\331\205\330\252\330\261)</span>\\n                    <input\\n                      type=\\\"number\\\"\\n                      min={0.8}\\n                      max={6}\\n                      step={0.1}\\n                      dir=\\\"ltr\\\"\\n                      value={heightMeters}\\n                      onChange={(e) => setHeightMeters(Math.max(0.8, Number(e.target.value) || 1))}\\n                      className=\\\"input-elessa w-full px-3 py-2 text-sm font-tech text-left\\\"\\n                    />\\n                  </label>\\n                </div>\\n\\n                <div className=\\\"flex items-center justify-between pt-2 border-t border-slate-200/80\\\">\\n                  <div>\\n                    <div className=\\\"text-[11px] text-[#565E74]\\\">\330\250\330\261\330\242\331\210\330\261\330\257 \330\252\331\202\330\261\333\214\330\250\333\214 \330\263\333\214\330\263\330\252\331\205</div>\\n                    <div className=\\\"text-base font-extrabold text-[#006C49] tabular-nums\\\">\\n                      {formatToman(estimate.totalPriceToman)}\\n                    </div>\\n                  </div>\\n                  <div className=\\\"text-left\\\">\\n                    <div className=\\\"text-[11px] text-[#565E74]\\\">\331\210\330\262\331\206 \330\252\331\202\330\261\333\214\330\250\333\214</div>\\n                    <div dir=\\\"ltr\\\" className=\\\"text-xs font-tech font-semibold text-[#0F172A]\\\">\\n                      {formatPersianNumber(estimate.estimatedWeightKg)} kg\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleAdd}\\n                  className=\\\"w-full btn-primary-elessa rounded-full py-3 px-5 text-sm font-bold inline-flex items-center justify-center gap-2 cursor-pointer\\\"\\n                >\\n                  {addedFeedback ? (\\n                    <>\\n                      <Check className=\\\"w-4 h-4\\\" />\\n                      <span>\330\250\331\207 \331\204\333\214\330\263\330\252 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261 \330\247\330\266\330\247\331\201\331\207 \330\264\330\257</span>\\n                    </>\\n                  ) : (\\n                    <>\\n                      <Plus className=\\\"w-4 h-4\\\" />\\n                      <span>\330\247\331\201\330\262\331\210\330\257\331\206 \330\250\330\247 \330\247\333\214\331\206 \331\205\330\264\330\256\330\265\330\247\330\252 \330\250\331\207 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261</span>\\n                    </>\\n                  )}\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Technical Specification List (Exact Spec: Zebra rows + Right-aligned Persian + Left-aligned LTR numeric) */}\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <h3 className=\\\"text-base font-bold text-[#0F172A]\\\">\330\254\330\257\331\210\331\204 \331\205\330\264\330\256\330\265\330\247\330\252 \331\201\331\206\333\214 \331\210 \331\205\331\207\331\206\330\257\330\263\333\214</h3>\\n              <span className=\\\"text-xs text-[#565E74]\\\">\\n                \332\257\330\247\330\261\330\247\331\206\330\252\333\214 \330\261\330\263\331\205\333\214: {formatPersianNumber(product.warrantyYears)} \330\263\330\247\331\204 \302\267 \330\252\330\255\331\210\333\214\331\204{\' \'}\\n                {product.leadTimeDays}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl border border-slate-200/80 overflow-hidden\\\">\\n              {product.specs.map((spec, idx) => (\\n                <div\\n                  key={spec.label}\\n                  className={`flex items-center justify-between gap-4 px-5 py-3.5 text-xs sm:text-sm ${\\n                    idx % 2 === 0 ? \'bg-[#F1F5F9]/65\' : \'bg-white\'\\n                  } ${idx !== product.specs.length - 1 ? \'border-b border-[#F1F5F9]\' : \'\'}`}\\n                >\\n                  <span className=\\\"text-[#334155] font-medium\\\">{spec.label}</span>\\n                  <div dir=\\\"ltr\\\" className=\\\"font-tech font-semibold text-[#0F172A] shrink-0\\\">\\n                    <span>{spec.value}</span>\\n                    {spec.unit && (\\n                      <span className=\\\"ml-1.5 text-xs font-normal text-[#565E74]\\\">\\n                        {spec.unit}\\n                      </span>\\n                    )}\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create ProductDetailModal with zebra-row RTL/LTR technical specs, finish selector, and instant quote configurator\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ProductDetailModal.tsx\", \"toolAction\":\"Creating ProductDetailModal component\", \"toolSummary\":\"Create ProductDetailModal component\"}"
