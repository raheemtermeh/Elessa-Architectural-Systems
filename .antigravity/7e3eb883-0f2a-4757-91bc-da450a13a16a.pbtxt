  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n:root {\n  --surface: #f8f9ff;\n  --surface-bg: #fafcfb;\n  --surface-white: #ffffff;\n  --surface-muted: #f1f5f9;\n  --surface-container-low: #eff4ff;\n  --primary: #006c49;\n  --primary-container: #10b981;\n  --emerald-dark: #059669;\n  --neon-mint: #00e676;\n  --emerald-glow: rgba(16, 185, 129, 0.35);\n  --charcoal-title: #0f172a;\n  --charcoal-body: #334155;\n  --on-surface: #0b1c30;\n  --secondary: #565e74;\n  --border-subtle: rgba(226, 232, 240, 0.8);\n  --glass-fill: rgba(255, 255, 255, 0.78);\n  --glass-border: rgba(255, 255, 255, 0.9);\n}\n\n@layer base {\n  html {\n    font-family: \"Vazirmatn\", \"Plus Jakarta Sans\", system-ui, -apple-system, sans-serif;\n    scroll-behavior: smooth;\n    background-color: var(--surface-bg);\n    color: var(--charcoal-title);\n  }\n\n  body {\n    line-height: 1.75;\n    overflow-x: hidden;\n  }\n\n  h1,\n  h2,\n  h3,\n  h4 {\n    text-wrap: balance;\n    line-height: 1.45;\n  }\n}\n\n.font-latin {\n  font-family: \"Plus Jakarta Sans\", \"Vazirmatn\", sans-serif;\n}\n\n.font-tech {\n  font-family: \"JetBrains Mono\", \"Plus Jakarta Sans\", monospace;\n  font-variant-numeric: tabular-nums;\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n/* Elevation Level 1: Structural Cards & Panels */\n.surface-card-1 {\n  background-color: var(--surface-white);\n  border: 1px solid var(--border-subtle);\n  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);\n}\n\n/* Elevation Level 2: Interactive Catalog Tiles */\n.surface-card-2 {\n  background-color: var(--surface-white);\n  border: 1px solid var(--border-subtle);\n  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);\n  transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1),\n    box-shadow 200ms cubic-bezier(0.16, 1, 0.3, 1),\n    border-color 200ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.surface-card-2:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 12px 32px -4px rgba(15, 23, 42, 0.08);\n  border-color: rgba(16, 185, 129, 0.4);\n}\n\n/* Elevation Level 3: Glassmorphic Navigation & Floating Bars */\n.glass-surface {\n  background-color: rgba(255, 255, 255, 0.78);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.9);\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\n}\n\n/* Glowing Primary Action Pill */\n.btn-primary-elessa {\n  background: linear-gradient(135deg, #059669 0%, #10b981 60%, #00d672 100%);\n  color: #ffffff;\n  box-shadow: 0 8px 24px -2px rgba(16, 185, 129, 0.35);\n  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1),\n    box-shadow 180ms cubic-bezier(0.16, 1, 0.3, 1),\n    filter 180ms ease;\n}\n\n.btn-primary-elessa:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 12px 28px -2px rgba(16, 185, 129, 0.45);\n  filter: brightness(1.03);\n}\n\n.btn-primary-elessa:active {\n  transform: translateY(0);\n}\n\n/* Secondary Frosted Action Pill */\n.btn-secondary-elessa {\n  background-color: rgba(255, 255, 255, 0.85);\n  color: #0f172a;\n  border: 1px solid rgba(203, 213, 225, 0.9);\n  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1),\n    border-color 180ms ease,\n    background-color 180ms ease,\n    color 180ms ease;\n}\n\n.btn-secondary-elessa:hover {\n  border-color: rgba(16, 185, 129, 0.55);\n  background-color: #ffffff;\n  color: #006c49;\n}\n\n/* Emerald Gradient Headline Accent */\n.text-emerald-gradient {\n  background: linear-gradient(270deg, #006c49 0%, #10b981 55%, #00c96a 100%);\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n}\n\n/* Quotation Input Fields */\n.input-elessa {\n  background-color: #ffffff;\n  border: 1px solid rgba(203, 213, 225, 0.7);\n  border-radius: 12px;\n  color: #0f172a;\n  transition: border-color 160ms ease, box-shadow 160ms ease;\n}\n\n.input-elessa:focus {\n  outline: none;\n  border-color: #10b981;\n  box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);\n}\n\n/* Active Filter Chip Glow */\n.chip-active-elessa {\n  background-color: #10b981;\n  color: #ffffff;\n  box-shadow: 0 6px 18px -2px rgba(16, 185, 129, 0.35);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
