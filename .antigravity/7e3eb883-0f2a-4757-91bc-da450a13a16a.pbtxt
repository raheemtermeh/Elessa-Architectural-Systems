              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'\330\252\331\204\331\201\333\214\331\202 \330\247\331\204\330\262\330\247\331\205\330\247\330\252 \330\247\331\205\331\206\333\214\330\252\333\214 \330\263\330\256\330\252\342\200\214\332\257\333\214\330\261\330\247\331\206\331\207 \330\265\331\206\331\201 \330\254\331\210\330\247\331\207\330\261\330\247\330\252 \330\250\330\247 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \330\262\333\214\330\250\330\247\333\214\333\214\342\200\214\330\264\331\206\330\247\330\256\330\252\333\214 \331\210\333\214\330\252\330\261\333\214\331\206 \333\262\333\264 \330\263\330\247\330\271\330\252\331\207 \331\205\330\254\330\252\331\205\330\271.\',"
