,\\n    },\\n  },\\n  {\\n    id: \'proj-parsian-gallery\',\\n    title: \'\332\257\330\247\331\204\330\261\333\214 \330\263\330\247\330\271\330\252 \331\210 \330\254\331\210\330\247\331\207\330\261\330\247\330\252 \331\276\330\247\330\261\330\263\333\214\330\247\331\206\',\\n    location: \'\330\252\331\207\330\261\330\247\331\206\330\214 \331\205\330\254\330\252\331\205\330\271 \330\252\330\254\330\247\330\261\333\214 \330\247\331\204\331\207\333\214\331\207\',\\n    year: \'\333\261\333\264\333\260\333\264\',\\n    category: \'electric-shutters\',\\n    categoryLabel: \'\332\251\330\261\332\251\330\261\331\207 \330\264\331\201\330\247\331\201 \331\210 \330\263\330\247\333\214\330\250\330\247\331\206 \330\247\330\263\331\276\330\247\333\214\330\257\330\261\',\\n    clientType: \'\330\256\330\261\330\257\331\207\342\200\214\331\201\330\261\331\210\330\264\333\214 \331\204\331\210\332\251\330\263\',\\n    image: IMAGES.polycarbonateShutter,\\n    areaOrCount: \'\333\264\333\270 \331\205\330\252\330\261\331\205\330\261\330\250\330\271 \332\251\330\261\332\251\330\261\331\207 + \330\263\330\247\333\214\330\250\330\247\331\206 \331\210\330\261\331\210\330\257\333\214\',\\n    deliveryDays: \'\333\271 \330\261\331\210\330\262 \332\251\330\247\330\261\333\214\',\\n    systemsUsed: [\'EL-PC90 \332\251\330\261\332\251\330\261\331\207 \330\264\331\201\330\247\331\201 \331\276\331\204\333\214\342\200\214\332\251\330\261\330\250\331\206\330\247\330\252\', \'EL-SP350 \330\263\330\247\333\214\330\250\330\247\331\206 \330\247\330\263\331\276\330\247\333\214\330\257\330\261\'],\\n    outcomeMetric: \'\331\206\331\205\330\247\333\214\330\264 \333\262\333\264 \330\263\330\247\330\271\330\252\331\207 \331\210\333\214\330\252\330\261\333\214\331\206 \330\250\330\247 \330\247\331\201\330\262\330\247\333\214\330\264 \333\262\333\270\331\252 \330\250\330\247\330\262\330\257\333\214\330\257\332\251\331\206\331\206\330\257\332\257\330\247\331\206 \330\271\330\265\330\261\332\257\330\247\331\207\333\214\',\\n    overview:\\n      \'\330\252\330\261\332\251\333\214\330\250 \332\251\330\261\332\251\330\261\331\207 \330\247\331\205\331\206\333\214\330\252\333\214 \330\252\331\205\330\247\331\205\342\200\214\330\264\331\201\330\247\331\201 \331\276\331\204\333\214\342\200\214\332\251\330\261\330\250\331\206\330\247\330\252 \330\250\330\247 \330\261\333\214\331\204\342\200\214\331\207\330\247\333\214 \331\205\330\256\331\201\333\214 \330\257\330\261 \331\202\330\247\330\250 \330\263\331\206\332\257 \331\210 \330\263\330\247\333\214\330\250\330\247\331\206 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \332\251\331\206\330\263\331\210\331\204\333\214 \330\250\330\247 \333\214\330\261\330\247\331\202\342\200\214\330\242\331\204\330\247\330\252 \330\247\330\263\330\252\333\214\331\204 \333\263\333\261\333\266.\',\\n    engineeringChallenge:\\n      \'\330\252\331\204\331\201\333\214\331\202 \330\247\331\204\330\262\330\247\331\205\330\247\330\252 \330\247\331\205\331\206\333\214\330\252\333\214 \330\263\330\256\330\252\342\200\214\332\257\333\214\330\261\330\247\331\206\331\207 \330\265\331\206\331\201 \330\254\331\210\330\247\331\207\330\261\330\247\330\252 \330\250\330\247 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \330\262\333\214\330\250\330\247\333\214\333\214\342\200\214\330\264\331\206\330\247\330\256\330\252\333\214 \331\210\333\214\330\252\330\261\333\214\331\206 \333\262\333\264 \330\263\330\247\330\271\330\252\331\207 \331\205\330\254\330\252\331\205\330\271.\',\\n    testimonial: {\\n      quote:\\n        \'\331\276\330\263 \330\247\330\262 \330\252\330\271\330\267\333\214\331\204\333\214 \331\201\330\261\331\210\330\264\332\257\330\247\331\207\330\214 \331\206\331\210\330\261\331\276\330\261\330\257\330\247\330\262\333\214 \331\210\333\214\330\252\330\261\333\214\331\206 \331\205\330\253\331\204 \330\261\331\210\330\262 \330\247\330\262 \331\276\330\264\330\252 \332\251\330\261\332\251\330\261\331\207 \330\264\331\201\330\247\331\201 \330\257\333\214\330\257\331\207 \331\205\333\214\342\200\214\330\264\331\210\330\257 \331\210 \331\207\331\205\342\200\214\330\262\331\205\330\247\331\206 \330\250\330\247\331\204\330\247\330\252\330\261\333\214\331\206 \330\247\331\205\331\206\333\214\330\252 \330\261\330\247 \330\257\330\247\330\261\333\214\331\205.\',\\n      author: \'\330\247\331\205\333\214\330\261\330\255\330\263\333\214\331\206 \332\251\330\247\330\270\331\205\333\214\',\\n      role: \'\331\205\330\257\333\214\330\261 \332\257\330\247\331\204\330\261\333\214\',\\n      organization: \'\332\257\330\247\331\204\330\261\333\214 \330\263\330\247\330\271\330\252 \331\276\330\247\330\261\330\263\333\214\330\247\331\206\',\\n    },\\n  },\\n];\\n\\nexport function formatPersianNumber(num: number): string {\\n  return new Intl.NumberFormat(\'fa-IR\').format(Math.round(num));\\n}\\n\\nexport function formatToman(amount: number): string {\\n  const millions = amount / 1_000_000;\\n  if (millions >= 1) {\\n    return `${new Intl.NumberFormat(\'fa-IR\', { maximumFractionDigits: 1 }).format(millions)} \331\205\333\214\331\204\333\214\331\210\331\206 \330\252\331\210\331\205\330\247\331\206`;\\n  }\\n  return `${formatPersianNumber(amount)} \330\252\331\210\331\205\330\247\331\206`;\\n}\\n\\nexport function calculateProductEstimate(params: {\\n  product: ArchitecturalProduct;\\n  widthMeters: number;\\n  heightMeters: number;\\n  finishMultiplier: number;\\n  glassMultiplier: number;\\n  gradeMultiplier: number;\\n  quantity: number;\\n}): {\\n  estimatedWeightKg: number;\\n  unitPriceToman: number;\\n  totalPriceToman: number;\\n  engineeringSummary: string;\\n} {\\n  const { product, widthMeters, heightMeters, finishMultiplier, glassMultiplier, gradeMultiplier, quantity } =\\n    params;\\n\\n  const area = Math.max(1, widthMeters * heightMeters);\\n  // Approximate glass weight: ~2.5 kg per m\302\262 per mm thickness (average 12mm doors, 17.5mm railing, 20mm canopy, 11.4kg/m\302\262 shutter)\\n  let kgPerSqm = 30;\\n  if (product.category === \'glass-railings\') kgPerSqm = 44;\\n  else if (product.category === \'smart-facades\') kgPerSqm = 52;\\n  else if (product.category === \'electric-shutters\') kgPerSqm = 11.4;\\n  else kgPerSqm = 30 * glassMultiplier;\\n\\n  const estimatedWeightKg = Math.round(area * kgPerSqm * quantity);\\n\\n  let baseUnit = product.basePriceToman;\\n  let engineeringSummary = \'\';\\n\\n  if (product.pricingUnit === \'opening\') {\\n    const widthFactor = Math.max(0.85, widthMeters / product.defaultWidth);\\n    const heightFactor = Math.max(0.9, heightMeters / product.defaultHeight);\\n    baseUnit = product.basePriceToman * (0.55 + 0.45 * widthFactor * heightFactor);\\n    const leaves = product.id === \'el-tl600\' ? \'\333\264 \331\204\330\252 \331\205\330\252\330\255\330\261\332\251 + \333\262 \331\204\330\252 \330\253\330\247\330\250\330\252\' : \'\333\262 \331\204\330\252 \331\205\330\252\330\255\330\261\332\251 + \333\262 \331\204\330\252 \330\253\330\247\330\250\330\252\';\\n    engineeringSummary = `${leaves} \302\267 \330\250\330\247\330\262\330\264\331\210\333\214 \331\205\331\201\333\214\330\257 \330\252\331\202\330\261\333\214\330\250\333\214 ${Math.round(\\n      widthMeters * (product.id === \'el-tl600\' ? 0.66 : 0.48) * 100\\n    )} cm`;\\n  } else if (product.pricingUnit === \'linear-meter\') {\\n    baseUnit = product.basePriceToman * widthMeters * (heightMeters / 1.1);\\n    const posts = Math.ceil(widthMeters / 0.95) + 1;\\n    engineeringSummary =\\n      product.id === \'el-uc180\'\\n        ? `${widthMeters.toFixed(1)} \331\205\330\252\330\261 \330\267\331\210\331\204 \331\276\330\261\331\210\331\201\333\214\331\204 U-Channel \330\257\331\201\331\206\333\214 \302\267 \330\264\333\214\330\264\331\207 \331\204\331\205\333\214\331\206\330\252 \330\263\330\247\330\262\331\207\342\200\214\330\247\333\214`\\n        : `${widthMeters.toFixed(1)} \331\205\330\252\330\261 \330\267\331\210\331\204 \302\267 ${posts} \330\271\330\257\330\257 \331\276\330\247\333\214\331\207 \330\247\330\263\331\276\333\214\332\257\330\247\330\252 \330\247\330\263\330\252\333\214\331\204 \333\263\333\261\333\266`;\\n  } else {\\n    baseUnit = product.basePriceToman * area;\\n    engineeringSummary =\\n      product.category === \'smart-facades\'\\n        ? `\331\205\330\263\330\247\330\255\330\252 \331\276\331\210\330\264\330\264 ${area.toFixed(1)} m\302\262 \302\267 \330\264\330\247\331\205\331\204 \331\205\331\207\330\247\330\261\332\251\330\264 \330\247\330\263\330\252\333\214\331\204 \331\210 \330\261\331\210\330\252\331\204 \331\205\331\201\330\265\331\204\333\214`\\n        : `\331\205\330\263\330\247\330\255\330\252 \330\257\331\207\330\247\331\206\331\207 ${area.toFixed(1)} m\302\262 \302\267 \331\205\331\210\330\252\331\210\330\261 \330\263\330\247\333\214\330\257 \330\250\331\207 \331\207\331\205\330\261\330\247\331\207 UPS \331\210 \330\261\333\214\331\205\331\210\330\252 \332\251\330\257\333\214\331\206\332\257`;\\n  }\\n\\n  const unitPriceToman = Math.round(baseUnit * finishMultiplier * glassMultiplier * gradeMultiplier);\\n  const totalPriceToman = unitPriceToman * Math.max(1, quantity);\\n\\n  return {\\n    estimatedWeightKg,\\n    unitPriceToman,\\n    totalPriceToman,\\n    engineeringSummary,\\n  };\\n}\\n\", \"Description\":\"Create static domain catalog, projects, finishes, and deterministic engineering estimator formulas for Elessa Architectural Systems\", \"Overwrite\":true, \"TargetFile\":\"/src/data/catalog.ts\", \"toolAction\":\"Creating catalog and project data\", \"toolSummary\":\"Create architectural catalog data\"}"
      original_name: "write_to_file"
    }
