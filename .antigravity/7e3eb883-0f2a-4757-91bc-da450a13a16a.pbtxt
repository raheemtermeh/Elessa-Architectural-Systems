  code_action {
    action_spec {
      create_file {
        instruction: "import { useEffect, useState } from \'react\';\nimport { Check, Plus, ShieldCheck, X } from \'lucide-react\';\nimport {\n  calculateProductEstimate,\n  formatPersianNumber,\n  formatToman,\n  type ArchitecturalProduct,\n  type QuoteItem,\n} from \'../data/catalog\';\nimport { ResilientImage } from \'./ResilientImage\';\n\ninterface ProductDetailModalProps {\n  product: ArchitecturalProduct | null;\n  onClose: () => void;\n  onAddConfiguredQuote: (item: QuoteItem) => void;\n}\n\nexport function ProductDetailModal({\n  product,\n  onClose,\n  onAddConfiguredQuote,\n}: ProductDetailModalProps) {\n  const [selectedFinishId, setSelectedFinishId] = useState<string>(\'\');\n  const [widthMeters, setWidthMeters] = useState<number>(3.2);\n  const [heightMeters, setHeightMeters] = useState<number>(2.6);\n  const [addedFeedback, setAddedFeedback] = useState(false);\n\n  useEffect(() => {\n    if (product) {\n      setSelectedFinishId(product.finishes[0]?.id || \'anodized-silver\');\n      setWidthMeters(product.defaultWidth);\n      setHeightMeters(product.defaultHeight);\n      setAddedFeedback(false);\n    }\n  }, [product]);\n\n  useEffect(() => {\n    if (!product) return;\n    const onKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') onClose();\n    };\n    window.addEventListener(\'keydown\', onKeyDown);\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\n  }, [product, onClose]);\n\n  if (!product) return null;\n\n  const selectedFinish =\n    product.finishes.find((f) => f.id === selectedFinishId) || product.finishes[0];\n\n  const estimate = calculateProductEstimate({\n    product,\n    widthMeters,\n    heightMeters,\n    finishMultiplier: selectedFinish.multiplier,\n    glassMultiplier: 1.0,\n    gradeMultiplier: 1.0,\n    quantity: 1,\n  });\n\n  const handleAdd = () => {\n    onAddConfiguredQuote({\n      id: `${product.id}-${Date.now()}`,\n      productId: product.id,\n      modelCode: product.modelCode,\n      name: product.name,\n      categoryLabel: product.categoryLabel,\n      finishLabel: selectedFinish.label,\n      glassSpec: \'\330\264\333\214\330\264\331\207 \330\247\330\263\330\252\330\247\331\206\330\257\330\247\330\261\330\257 \331\204\331\205\333\214\331\206\330\252 / \330\263\332\251\331\210\330\261\333\214\330\252\',\n      widthMeters,\n      heightMeters,\n      quantity: 1,\n      estimatedWeightKg: estimate.estimatedWeightKg,\n      estimatedPriceToman: estimate.totalPriceToman,\n    });\n    setAddedFeedback(true);\n    setTimeout(() => {\n      setAddedFeedback(false);\n    }, 1800);\n  };\n\n  return (\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"product-detail-title\"\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#0F172A]/45 backdrop-blur-sm overflow-y-auto\"\n      onClick={onClose}\n    >\n      <div\n        className=\"w-full max-w-4xl bg-white rounded-[32px] border border-white shadow-[0_24px_64px_-12px_rgba(15,23,42,0.28)] overflow-hidden my-auto max-h-[90vh] flex flex-col\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Top Modal Bar */}\n        <div className=\"px-6 sm:px-8 py-5 border-b border-slate-100 flex items-center justify-between gap-4 shrink-0\">\n          <div className=\"flex flex-wrap items-center gap-2.5 min-w-0\">\n            <span className=\"font-tech text-xs font-semibold text-[#006C49] bg-[#10B981]/10 px-3 py-1 rounded-full\">\n              {product.modelCode}\n            </span>\n            <span className=\"text-xs text-[#565E74]\">{product.categoryLabel}</span>\n            <span aria-hidden=\"true\" className=\"text-slate-300\">\n              \302\267\n            </span>\n            <span className=\"text-xs text-[#565E74] font-tech\">{product.standardCode}</span>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"w-9 h-9 rounded-full bg-[#F1F5F9] text-[#334155] hover:bg-slate-200 inline-flex items-center justify-center transition-colors cursor-pointer shrink-0\"\n            aria-label=\"\330\250\330\263\330\252\331\206 \331\276\331\206\330\254\330\261\331\207 \331\205\330\264\330\256\330\265\330\247\330\252 \331\201\331\206\333\214\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Scrollable Content */}\n        <div className=\"overflow-y-auto p-6 sm:p-8 space-y-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-7 items-start\">\n            {/* Image + Highlights */}\n            <div className=\"lg:col-span-6 space-y-4\">\n              <div className=\"aspect-[16/10] rounded-[24px] overflow-hidden border border-slate-200/70\">\n                <ResilientImage\n                  src={product.image}\n                  alt={product.name}\n                  className=\"w-full h-full object-cover\"\n                />\n              </div>\n\n              <div className=\"rounded-2xl bg-[#FAFCFB] border border-slate-200/70 p-4 space-y-2.5\">\n                <div className=\"text-xs font-semibold text-[#006C49] flex items-center gap-1.5\">\n                  <ShieldCheck className=\"w-4 h-4\" />\n                  <span>\331\206\332\251\330\252\331\207 \331\205\331\207\331\206\330\257\330\263\333\214 \330\247\331\204\330\263\330\247</span>\n                </div>\n                <p className=\"text-xs sm:text-[13px] text-[#334155] leading-6\">\n                  {product.engineeringNote}\n                </p>\n              </div>\n            </div>\n\n            {/* Title, Finish Selector & Inline Quick Estimator */}\n            <div className=\"lg:col-span-6 space-y-5\">\n              <div className=\"space-y-2\">\n                <h2\n                  id=\"product-detail-title\"\n                  className=\"text-xl sm:text-2xl font-extrabold text-[#0F172A]\"\n                >\n                  {product.name}\n                </h2>\n                <p className=\"text-sm text-[#334155] leading-7\">{product.summary}</p>\n              </div>\n\n              {/* Finish Swatches */}\n              <div className=\"space-y-2.5\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <span className=\"font-semibold text-[#0F172A]\">\331\276\331\210\330\264\330\264 \331\210 \330\261\331\206\332\257 \331\276\330\261\331\210\331\201\333\214\331\204:</span>\n                  <span className=\"text-[#565E74]\">\n                    {selectedFinish.label} ({selectedFinish.code})\n                  </span>\n                </div>\n                <div className=\"grid grid-cols-2 gap-2\">\n                  {product.finishes.map((finish) => {\n                    const active = finish.id === selectedFinish.id;\n                    return (\n                      <button\n                        key={finish.id}\n                        type=\"button\"\n                        onClick={() => setSelectedFinishId(finish.id)}\n                        className={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl border text-right text-xs font-medium transition-all cursor-pointer ${\n                          active\n                            ? \'border-[#10B981] bg-[#10B981]/5 text-[#006C49]\'\n                            : \'border-slate-200 hover:border-slate-300 text-[#334155]\'\n                        }`}\n                      >\n                        <span\n                          aria-hidden=\"true\"\n                          className=\"w-4 h-4 rounded-full border border-black/15 shrink-0\"\n                          style={{ backgroundColor: finish.swatch }}\n                        />\n                        <span className=\"truncate\">{finish.label}</span>\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Quick Dimension Adjuster */}\n              <div className=\"rounded-2xl bg-[#F1F5F9]/75 p-4 space-y-4\">\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <label className=\"space-y-1.5 text-xs\">\n                    <span className=\"block font-semibold text-[#0F172A]\">\n                      {product.pricingUnit === \'linear-meter\' ? \'\330\267\331\210\331\204 \332\251\331\204 (\331\205\330\252\330\261)\' : \'\330\271\330\261\330\266 \330\257\331\207\330\247\331\206\331\207 (\331\205\330\252\330\261)\'}\n                    </span>\n                    <input\n                      type=\"number\"\n                      min={1}\n                      max={30}\n                      step={0.1}\n                      dir=\"ltr\"\n                      value={widthMeters}\n                      onChange={(e) => setWidthMeters(Math.max(1, Number(e.target.value) || 1))}\n                      className=\"input-elessa w-full px-3 py-2 text-sm font-tech text-left\"\n                    />\n                  </label>\n                  <label className=\"space-y-1.5 text-xs\">\n                    <span className=\"block font-semibold text-[#0F172A]\">\330\247\330\261\330\252\331\201\330\247\330\271 (\331\205\330\252\330\261)</span>\n                    <input\n                      type=\"number\"\n                      min={0.8}\n                      max={6}\n                      step={0.1}\n                      dir=\"ltr\"\n                      value={heightMeters}\n                      onChange={(e) => setHeightMeters(Math.max(0.8, Number(e.target.value) || 1))}\n                      className=\"input-elessa w-full px-3 py-2 text-sm font-tech text-left\"\n                    />\n                  </label>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-2 border-t border-slate-200/80\">\n                  <div>\n                    <div className=\"text-[11px] text-[#565E74]\">\330\250\330\261\330\242\331\210\330\261\330\257 \330\252\331\202\330\261\333\214\330\250\333\214 \330\263\333\214\330\263\330\252\331\205</div>\n                    <div className=\"text-base font-extrabold text-[#006C49] tabular-nums\">\n                      {formatToman(estimate.totalPriceToman)}\n                    </div>\n                  </div>\n                  <div className=\"text-left\">\n                    <div className=\"text-[11px] text-[#565E74]\">\331\210\330\262\331\206 \330\252\331\202\330\261\333\214\330\250\333\214</div>\n                    <div dir=\"ltr\" className=\"text-xs font-tech font-semibold text-[#0F172A]\">\n                      {formatPersianNumber(estimate.estimatedWeightKg)} kg\n                    </div>\n                  </div>\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={handleAdd}\n                  className=\"w-full btn-primary-elessa rounded-full py-3 px-5 text-sm font-bold inline-flex items-center justify-center gap-2 cursor-pointer\"\n                >\n                  {addedFeedback ? (\n                    <>\n                      <Check className=\"w-4 h-4\" />\n                      <span>\330\250\331\207 \331\204\333\214\330\263\330\252 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261 \330\247\330\266\330\247\331\201\331\207 \330\264\330\257</span>\n                    </>\n                  ) : (\n                    <>\n                      <Plus className=\"w-4 h-4\" />\n                      <span>\330\247\331\201\330\262\331\210\330\257\331\206 \330\250\330\247 \330\247\333\214\331\206 \331\205\330\264\330\256\330\265\330\247\330\252 \330\250\331\207 \331\276\333\214\330\264\342\200\214\331\201\330\247\332\251\330\252\331\210\330\261</span>\n                    </>\n                  )}\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Technical Specification List (Exact Spec: Zebra rows + Right-aligned Persian + Left-aligned LTR numeric) */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-[#0F172A]\">\330\254\330\257\331\210\331\204 \331\205\330\264\330\256\330\265\330\247\330\252 \331\201\331\206\333\214 \331\210 \331\205\331\207\331\206\330\257\330\263\333\214</h3>\n              <span className=\"text-xs text-[#565E74]\">\n                \332\257\330\247\330\261\330\247\331\206\330\252\333\214 \330\261\330\263\331\205\333\214: {formatPersianNumber(product.warrantyYears)} \330\263\330\247\331\204 \302\267 \330\252\330\255\331\210\333\214\331\204{\' \'}\n                {product.leadTimeDays}\n              </span>\n            </div>\n\n            <div className=\"rounded-2xl border border-slate-200/80 overflow-hidden\">\n              {product.specs.map((spec, idx) => (\n                <div\n                  key={spec.label}\n                  className={`flex items-center justify-between gap-4 px-5 py-3.5 text-xs sm:text-sm ${\n                    idx % 2 === 0 ? \'bg-[#F1F5F9]/65\' : \'bg-white\'\n                  } ${idx !== product.specs.length - 1 ? \'border-b border-[#F1F5F9]\' : \'\'}`}\n                >\n                  <span className=\"text-[#334155] font-medium\">{spec.label}</span>\n                  <div dir=\"ltr\" className=\"font-tech font-semibold text-[#0F172A] shrink-0\">\n                    <span>{spec.value}</span>\n                    {spec.unit && (\n                      <span className=\"ml-1.5 text-xs font-normal text-[#565E74]\">\n                        {spec.unit}\n                      </span>\n                    )}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/ProductDetailModal.tsx"
        }
        overwrite: true
      }
    }
