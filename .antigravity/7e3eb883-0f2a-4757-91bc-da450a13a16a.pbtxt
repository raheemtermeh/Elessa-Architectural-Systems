            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function formatToman(amount: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const millions = amount / 1_000_000;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (millions >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return `${new Intl.NumberFormat(\'fa-IR\', { maximumFractionDigits: 1 }).format(millions)} \331\205\333\214\331\204\333\214\331\210\331\206 \330\252\331\210\331\205\330\247\331\206`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `${formatPersianNumber(amount)} \330\252\331\210\331\205\330\247\331\206`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateProductEstimate(params: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  product: ArchitecturalProduct;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  widthMeters: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  heightMeters: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  finishMultiplier: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  glassMultiplier: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  gradeMultiplier: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  quantity: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}): {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  estimatedWeightKg: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  unitPriceToman: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  totalPriceToman: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  engineeringSummary: string;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "} {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const { product, widthMeters, heightMeters, finishMultiplier, glassMultiplier, gradeMultiplier, quantity } ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    params;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const area = Math.max(1, widthMeters * heightMeters);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Approximate glass weight: ~2.5 kg per m\302\262 per mm thickness (average 12mm doors, 17.5mm railing, 20mm canopy, 11.4kg/m\302\262 shutter)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let kgPerSqm = 30;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (product.category === \'glass-railings\') kgPerSqm = 44;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  else if (product.category === \'smart-facades\') kgPerSqm = 52;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  else if (product.category === \'electric-shutters\') kgPerSqm = 11.4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  else kgPerSqm = 30 * glassMultiplier;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const estimatedWeightKg = Math.round(area * kgPerSqm * quantity);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let baseUnit = product.basePriceToman;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let engineeringSummary = \'\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (product.pricingUnit === \'opening\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const widthFactor = Math.max(0.85, widthMeters / product.defaultWidth);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const heightFactor = Math.max(0.9, heightMeters / product.defaultHeight);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    baseUnit = product.basePriceToman * (0.55 + 0.45 * widthFactor * heightFactor);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const leaves = product.id === \'el-tl600\' ? \'\333\264 \331\204\330\252 \331\205\330\252\330\255\330\261\332\251 + \333\262 \331\204\330\252 \330\253\330\247\330\250\330\252\' : \'\333\262 \331\204\330\252 \331\205\330\252\330\255\330\261\332\251 + \333\262 \331\204\330\252 \330\253\330\247\330\250\330\252\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    engineeringSummary = `${leaves} \302\267 \330\250\330\247\330\262\330\264\331\210\333\214 \331\205\331\201\333\214\330\257 \330\252\331\202\330\261\333\214\330\250\333\214 ${Math.round("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      widthMeters * (product.id === \'el-tl600\' ? 0.66 : 0.48) * 100"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    )} cm`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (product.pricingUnit === \'linear-meter\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    baseUnit = product.basePriceToman * widthMeters * (heightMeters / 1.1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const posts = Math.ceil(widthMeters / 0.95) + 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    engineeringSummary ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      product.id === \'el-uc180\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? `${widthMeters.toFixed(1)} \331\205\330\252\330\261 \330\267\331\210\331\204 \331\276\330\261\331\210\331\201\333\214\331\204 U-Channel \330\257\331\201\331\206\333\214 \302\267 \330\264\333\214\330\264\331\207 \331\204\331\205\333\214\331\206\330\252 \330\263\330\247\330\262\331\207\342\200\214\330\247\333\214`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : `${widthMeters.toFixed(1)} \331\205\330\252\330\261 \330\267\331\210\331\204 \302\267 ${posts} \330\271\330\257\330\257 \331\276\330\247\333\214\331\207 \330\247\330\263\331\276\333\214\332\257\330\247\330\252 \330\247\330\263\330\252\333\214\331\204 \333\263\333\261\333\266`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    baseUnit = product.basePriceToman * area;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    engineeringSummary ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      product.category === \'smart-facades\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? `\331\205\330\263\330\247\330\255\330\252 \331\276\331\210\330\264\330\264 ${area.toFixed(1)} m\302\262 \302\267 \330\264\330\247\331\205\331\204 \331\205\331\207\330\247\330\261\332\251\330\264 \330\247\330\263\330\252\333\214\331\204 \331\210 \330\261\331\210\330\252\331\204 \331\205\331\201\330\265\331\204\333\214`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : `\331\205\330\263\330\247\330\255\330\252 \330\257\331\207\330\247\331\206\331\207 ${area.toFixed(1)} m\302\262 \302\267 \331\205\331\210\330\252\331\210\330\261 \330\263\330\247\333\214\330\257 \330\250\331\207 \331\207\331\205\330\261\330\247\331\207 UPS \331\210 \330\261\333\214\331\205\331\210\330\252 \332\251\330\257\333\214\331\206\332\257`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const unitPriceToman = Math.round(baseUnit * finishMultiplier * glassMultiplier * gradeMultiplier);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const totalPriceToman = unitPriceToman * Math.max(1, quantity);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estimatedWeightKg,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    unitPriceToman,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
