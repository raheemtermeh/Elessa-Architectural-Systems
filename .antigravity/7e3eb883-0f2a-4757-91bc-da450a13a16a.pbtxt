\261\331\210\331\201\342\200\214\332\257\330\247\330\261\330\257\331\206\',\n    deliveryDays: \'\333\261\333\261 \330\261\331\210\330\262 \332\251\330\247\330\261\333\214\',\n    systemsUsed: [\'EL-UC180 \330\257\331\201\331\206\333\214 \330\250\330\247 \330\264\333\214\330\264\331\207 \333\262\333\260 \331\205\333\214\331\204 \330\263\331\210\331\276\330\261\332\251\331\204\333\214\330\261\'],\n    outcomeMetric: \'\331\205\331\202\330\247\331\210\331\205\330\252 \330\252\330\247\333\214\333\214\330\257\330\264\330\257\331\207 \330\252\330\247 \330\263\330\261\330\271\330\252 \330\250\330\247\330\257 \333\261\333\262\333\260 \332\251\333\214\331\204\331\210\331\205\330\252\330\261 \330\250\330\261 \330\263\330\247\330\271\330\252 \330\257\330\261 \330\247\330\261\330\252\331\201\330\247\330\271\',\n    overview:\n      \'\330\247\330\254\330\261\330\247\333\214 \331\276\333\214\331\210\330\263\330\252\331\207 \330\254\330\247\331\206\342\200\214\331\276\331\206\330\247\331\207 \330\264\333\214\330\264\331\207\342\200\214\330\247\333\214 \330\250\330\257\331\210\331\206 \331\202\330\247\330\250 \330\257\331\210\330\261 \330\252\330\261\330\247\330\263\342\200\214\331\207\330\247\333\214 \332\251\331\206\330\263\331\210\331\204\333\214 \330\250\330\252\331\206\333\214 \330\250\330\247 \331\207\330\257\331\201 \330\255\331\201\330\270 \330\257\333\214\330\257 \331\205\330\267\331\204\331\202 \330\250\331\207 \332\206\330\264\331\205\342\200\214\330\247\331\206\330\257\330\247\330\262 \330\257\330\261\331\207 \331\210 \332\251\331\210\331\207\330\263\330\252\330\247\331\206.\',\n    engineeringChallenge:\n      \'\331\205\331\207\330\247\330\261 \330\261\330\267\331\210\330\250\330\252 \331\210 \333\214\330\256\342\200\214\330\250\331\206\330\257\330\247\331\206 \330\262\331\205\330\263\330\252\330\247\331\206\333\214 \331\205\331\206\330\267\331\202\331\207 \332\251\331\210\331\207\330\263\330\252\330\247\331\206\333\214 \330\247\330\262 \330\267\330\261\333\214\331\