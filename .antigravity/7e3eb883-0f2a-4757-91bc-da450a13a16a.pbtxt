            }
            lines {
              text: "export function formatPersianNumber(num: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return new Intl.NumberFormat(\'fa-IR\').format(Math.round(num));"
