# Server
HOST=0.0.0.0
PORT=1337

# Secrets (Generate using: openssl rand -base64 32)
APP_KEYS=elessaAppKey1,elessaAppKey2,elessaAppKey3,elessaAppKey4
API_TOKEN_SALT=elessaApiTokenSalt2026
ADMIN_JWT_SECRET=elessaAdminJwtSecret2026
TRANSFER_TOKEN_SALT=elessaTransferTokenSalt2026
JWT_SECRET=elessaUsersJwtSecret2026

# Database (Default: SQLite file inside .tmp/data.db)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Frontend CORS
FRONTEND_URL=http://localhost:3000
